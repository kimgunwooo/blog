---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GlobalSidebar from '../components/GlobalSidebar.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	relatedPosts?: CollectionEntry<'blog'>[];
};

const {
	title,
	description,
	pubDate,
	createdAt,
	updatedDate,
	showTime = false,
	heroImage,
	tags = [],
	relatedPosts = [],
} = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			article={true}
			pubDate={pubDate}
			updatedDate={updatedDate}
			tags={tags}
		/>
		<style>
			.post-main {
				width: min(100%, 1180px);
				max-width: 1180px;
				min-width: 0;
			}
			.post-layout {
				width: 100%;
				max-width: none;
				margin: 0;
				padding: 2.5rem 2rem 2.5rem 1.5rem;
				grid-template-columns: 220px minmax(0, 1fr);
				gap: 3rem;
			}
			.post-shell {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 260px;
				gap: 2.5rem;
				align-items: start;
				justify-content: center;
			}
			.post-shell > article {
				min-width: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.reading-progress {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 1100;
				width: 100%;
				height: 3px;
				pointer-events: none;
			}
			.reading-progress__bar {
				display: block;
				width: 100%;
				height: 100%;
				background: var(--accent);
				transform: scaleX(0);
				transform-origin: left center;
				transition: transform 80ms linear;
			}
			.prose {
				width: 100%;
				max-width: 820px;
				margin: 0 auto;
				padding: 2rem 0 4rem;
				color: rgb(var(--gray-dark));
			}
			.post-toc {
				position: sticky;
				top: 5.5rem;
				display: none;
				max-height: calc(100vh - 7rem);
				margin-top: 3.65rem;
				padding: 0.25rem 0 0.25rem 1.25rem;
				border-left: 2px solid rgb(var(--line));
				overflow-x: hidden;
				overflow-y: auto;
				scrollbar-width: none;
			}
			.post-toc::-webkit-scrollbar {
				display: none;
				width: 0;
			}
			.post-toc.is-scrolling {
				scrollbar-width: thin;
			}
			.post-toc.is-scrolling::-webkit-scrollbar {
				display: block;
				width: 6px;
			}
			.post-toc::-webkit-scrollbar-track {
				background: transparent;
			}
			.post-toc::-webkit-scrollbar-thumb {
				background: rgba(var(--line), 0.9);
				border-radius: 999px;
			}
			.post-toc::-webkit-scrollbar-thumb:hover {
				background: rgba(var(--muted), 0.45);
			}
			.post-toc.is-visible {
				display: block;
			}
			.toc-title {
				display: none;
			}
			.toc-list {
				display: grid;
				gap: 0.5rem;
			}
			:global(.post-toc .toc-link) {
				display: block;
				margin-left: 0;
					padding: 0;
					color: rgb(var(--muted));
				font-size: 0.78rem;
				line-height: 1.5;
				text-decoration: none;
				overflow-wrap: anywhere;
				transition:
					color 160ms ease,
					font-size 160ms ease,
					transform 160ms ease;
			}
			:global(.post-toc .toc-link:hover) {
				color: rgb(var(--gray-dark));
			}
			:global(.post-toc .toc-link.is-active) {
				color: rgb(var(--black));
				font-size: 0.88rem;
				font-weight: 800;
				transform: translateX(0.15rem);
			}
			:global(.post-toc .toc-link[data-level='3']) {
				padding-left: 1rem;
				font-size: 0.74rem;
			}
			:global(.post-toc .toc-link[data-level='3'].is-active) {
				font-size: 0.84rem;
			}
			.title {
				margin-bottom: 2rem;
				padding: 2rem 0 1.5rem;
				border-bottom: 1px solid rgb(var(--line));
				line-height: 1.25;
			}
			.title h1 {
				margin: 0 0 0.65rem;
				font-size: clamp(1.9rem, 3.4vw, 2.75rem);
			}
			.description {
				max-width: 820px;
				margin: 0;
				color: rgb(var(--muted));
				font-size: 1.05rem;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--accent);
				font-size: 0.88rem;
				font-weight: 700;
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 1rem;
			}
			.tags span {
				padding: 0.25rem 0.5rem;
				background: rgb(var(--surface));
				border: 1px solid rgb(var(--line));
				border-radius: 999px;
				color: rgb(var(--muted));
				font-size: 0.78rem;
			}
			.prose :global(h2) {
				margin-top: 2.2rem;
				font-size: 1.55rem;
				scroll-margin-top: 5.5rem;
			}
			.prose :global(h3) {
				margin-top: 1.75rem;
				scroll-margin-top: 5.5rem;
			}
			.prose :global(li) {
				margin-bottom: 0.35rem;
			}
			.prose :global(table) {
				width: 100%;
				margin: 1.25rem 0 1.75rem;
				border: 1px solid rgb(var(--line));
				border-collapse: separate;
				border-spacing: 0;
				border-radius: 10px;
				background: rgb(var(--surface-strong));
				box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
				font-size: 0.93rem;
				line-height: 1.55;
				overflow: hidden;
			}
			.prose :global(thead) {
				background: rgb(var(--gray-light) / 0.35);
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.85rem 1rem;
				border-bottom: 1px solid rgb(var(--line));
				text-align: left;
				vertical-align: top;
			}
			.prose :global(th + th),
			.prose :global(td + td) {
				border-left: 1px solid rgb(var(--line));
			}
			.prose :global(th) {
				color: rgb(var(--black));
				font-weight: 800;
				white-space: nowrap;
			}
			.prose :global(tbody tr:nth-child(even)) {
				background: rgb(var(--surface) / 0.55);
			}
			.prose :global(td:first-child) {
				width: 13rem;
				white-space: nowrap;
			}
			.prose :global(tr:last-child td) {
				border-bottom: 0;
			}
			.prose :global(td code) {
				font-size: 0.9em;
				font-weight: 700;
			}
			.prose :global(.code-block-wrap) {
				position: relative;
				display: flow-root;
				margin: 1em 0;
			}
			.prose :global(.code-block) {
				margin: 0;
				padding-right: 4.5rem;
			}
			.prose :global(.code-copy) {
				position: absolute;
				top: 0.65rem;
				right: 0.65rem;
				display: grid;
				place-items: center;
				width: 2rem;
				height: 2rem;
				padding: 0;
				border: 1px solid rgba(148, 163, 184, 0.45);
				border-radius: 7px;
				background: rgba(15, 23, 42, 0.78);
				color: rgb(var(--gray-dark));
				cursor: pointer;
				transition:
					background-color 160ms ease,
					color 160ms ease;
			}
			.prose :global(.code-copy:hover),
			.prose :global(.code-copy[data-copied='true']) {
				background: rgb(var(--surface));
				color: var(--accent);
			}
			.prose :global(.code-copy svg) {
				width: 1rem;
				height: 1rem;
			}
			.prose :global(.image-zoom-frame) {
				position: relative;
				margin: 1.75rem 0 2.25rem;
			}
			.prose :global(.image-zoom-frame > img) {
				display: block;
				width: 100%;
				margin: 0;
				cursor: zoom-in;
			}
			.prose :global(.image-zoom-button) {
				position: absolute;
				top: 0.65rem;
				right: 0.65rem;
				display: grid;
				place-items: center;
				width: 2.15rem;
				height: 2.15rem;
				padding: 0;
				border: 1px solid rgb(var(--line));
				border-radius: 8px;
				background: rgb(var(--surface-strong) / 0.94);
				color: rgb(var(--muted));
				cursor: zoom-in;
				box-shadow: 0 6px 14px rgba(15, 23, 42, 0.08);
				transition:
					background-color 160ms ease,
					color 160ms ease,
					transform 160ms ease;
			}
			.prose :global(.image-zoom-button:hover) {
				background: rgb(var(--surface));
				color: var(--accent);
				transform: translateY(-1px);
			}
			.prose :global(.image-zoom-button svg) {
				width: 1rem;
				height: 1rem;
			}
			:global(.image-modal) {
				box-sizing: border-box;
				width: min(96vw, 1500px);
				max-width: none;
				height: min(92vh, 1000px);
				max-height: none;
				padding: 0;
				border: 1px solid rgba(255, 255, 255, 0.24);
				border-radius: 14px;
				background: rgb(var(--surface-strong));
				overflow: hidden;
			}
			:global(.image-modal::backdrop) {
				background: rgba(15, 23, 42, 0.72);
				backdrop-filter: blur(5px);
			}
			:global(.image-modal__bar) {
				position: absolute;
				top: 0.75rem;
				right: 0.75rem;
				z-index: 2;
				display: flex;
				align-items: center;
				gap: 0.4rem;
				justify-content: flex-end;
			}
			:global(.image-modal__hint) {
				margin-right: 0.35rem;
				color: rgb(var(--muted));
				font-size: 0.75rem;
			}
			:global(.image-modal__zoom-button),
			:global(.image-modal__close) {
				width: 2.25rem;
				height: 2.25rem;
				border: 1px solid rgba(255, 255, 255, 0.28);
				border-radius: 10px;
				background: rgb(var(--surface-strong) / 0.95);
				color: rgb(var(--gray-dark));
				font-size: 1.25rem;
				line-height: 1;
				cursor: pointer;
			}
			:global(.image-modal__zoom-button) {
				font-weight: 700;
			}
			:global(.image-modal__zoom-button--fit) {
				width: auto;
				padding: 0 0.7rem;
				font-size: 0.78rem;
			}
			:global(.image-modal__content) {
				box-sizing: border-box;
				width: 100%;
				height: 100%;
				padding: 1rem;
				overflow: hidden;
				scrollbar-width: none;
				-ms-overflow-style: none;
				overscroll-behavior: contain;
				cursor: grab;
				touch-action: none;
			}
			:global(.image-modal__content.is-zoomed) {
				overflow: auto;
			}
			:global(.image-modal__content::-webkit-scrollbar),
			:global(.diagram-modal__body::-webkit-scrollbar) {
				width: 0;
				height: 0;
			}
			:global(.image-modal__content.is-panning) {
				cursor: grabbing;
				user-select: none;
			}
			:global(.image-modal__stage) {
				display: grid;
				width: max-content;
				min-width: 100%;
				height: max-content;
				min-height: 100%;
				box-sizing: border-box;
				place-items: center;
			}
			:global(.image-modal__content img) {
				display: block;
				max-width: none;
				max-height: none;
				border-radius: 8px;
			}
			.related-posts {
				margin-top: 4rem;
				padding-top: 1.5rem;
				border-top: 2px solid var(--accent);
			}
			.related-posts__eyebrow {
				margin: 0 0 0.25rem;
				color: var(--accent);
				font-size: 0.75rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.related-posts h2 {
				margin: 0 0 0.8rem;
				font-size: 1.25rem;
			}
			.related-posts__list {
				display: grid;
				border-top: 1px solid rgb(var(--line));
			}
			.related-posts__item {
				display: grid;
				gap: 0.2rem;
				padding: 0.9rem 0;
				border-bottom: 1px solid rgb(var(--line));
				color: inherit;
				text-decoration: none;
			}
			.related-posts__item:hover strong {
				color: var(--accent);
			}
			.related-posts__meta,
			.related-posts__description {
				color: rgb(var(--muted));
				font-size: 0.82rem;
				line-height: 1.5;
			}
			.related-posts__item strong {
				color: rgb(var(--black));
				font-size: 0.98rem;
				transition: color 160ms ease;
			}
			.comments {
				margin-top: 4rem;
				padding-top: 1.5rem;
				border-top: 2px solid var(--accent);
			}
			.comments__eyebrow {
				margin: 0 0 0.25rem;
				color: var(--accent);
				font-size: 0.75rem;
				font-weight: 800;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.comments h2 {
				margin: 0 0 1rem;
				font-size: 1.25rem;
			}
			.giscus {
				min-height: 8rem;
			}
			.prose :global(.mermaid-frame) {
				position: relative;
				margin: 1.75rem 0 2.25rem;
				background:
					linear-gradient(180deg, rgb(var(--surface) / 0.74) 0%, rgb(var(--surface-strong)) 100%),
					rgb(var(--surface-strong));
				border: 1px solid rgb(var(--line));
				border-radius: 14px;
				box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
			}
			.prose :global(.mermaid-canvas) {
				padding: 1.5rem;
				overflow-x: auto;
			}
			.prose :global(.mermaid) {
				min-width: max-content;
			}
			.prose :global(.mermaid svg) {
				display: block;
				max-width: 100%;
				height: auto;
				margin: 0 auto;
			}
			.prose :global(.mermaid .node rect),
			.prose :global(.mermaid .node polygon),
			.prose :global(.mermaid .node path) {
				stroke-width: 1.6px !important;
				filter: drop-shadow(0 6px 10px rgba(15, 23, 42, 0.06));
			}
			.prose :global(.mermaid .cluster rect) {
				stroke-width: 1.4px !important;
				rx: 8px;
			}
			.prose :global(.mermaid .edgeLabel) {
				border-radius: 6px;
				color: rgb(var(--muted));
				font-size: 0.88rem;
			}
			.prose :global(.mermaid .edgeLabel p) {
				background: rgb(var(--surface-strong) / 0.92) !important;
				border: 1px solid rgb(var(--line));
				border-radius: 6px;
				padding: 0.08rem 0.28rem;
			}
			.prose :global(.mermaid .label),
			.prose :global(.mermaid .nodeLabel) {
				line-height: 1.35;
			}
			.prose :global(.mermaid-expand) {
				position: absolute;
				top: 0.6rem;
				right: 0.6rem;
				z-index: 2;
				width: 2rem;
				height: 2rem;
				border: 1px solid rgb(var(--line));
				border-radius: 8px;
				background: rgb(var(--surface-strong) / 0.92);
				color: rgb(var(--muted));
				font-size: 1rem;
				line-height: 1;
				cursor: pointer;
				box-shadow: 0 6px 14px rgba(15, 23, 42, 0.06);
				transition:
					background-color 160ms ease,
					color 160ms ease,
					transform 160ms ease;
			}
			.prose :global(.mermaid-expand:hover) {
				background: rgb(var(--surface));
				color: var(--accent);
				transform: translateY(-1px);
			}
			:global(.diagram-modal) {
				position: fixed;
				inset: 0;
				z-index: 1000;
				display: grid;
				place-items: center;
				padding: 1rem;
				background: rgba(15, 23, 42, 0.72);
				backdrop-filter: blur(6px);
			}
			:global(.diagram-modal[hidden]) {
				display: none;
			}
			:global(.diagram-modal__bar) {
				position: absolute;
				top: 1rem;
				right: 1rem;
				display: flex;
				align-items: center;
				gap: 0.4rem;
				justify-content: flex-end;
			}
			:global(.diagram-modal__hint) {
				margin-right: 0.35rem;
				color: rgba(255, 255, 255, 0.82);
				font-size: 0.75rem;
			}
			:global(.diagram-modal__zoom-button),
			:global(.diagram-modal__close) {
				width: 2.25rem;
				height: 2.25rem;
				border: 1px solid rgba(255, 255, 255, 0.28);
				border-radius: 10px;
				background: rgb(var(--surface-strong) / 0.95);
				color: rgb(var(--gray-dark));
				font-size: 1.25rem;
				line-height: 1;
				cursor: pointer;
			}
			:global(.diagram-modal__zoom-button) {
				font-weight: 700;
			}
			:global(.diagram-modal__zoom-button--fit) {
				width: auto;
				padding: 0 0.7rem;
				font-size: 0.78rem;
			}
			:global(.diagram-modal__body) {
				box-sizing: border-box;
				width: min(94vw, 1440px);
				height: min(86vh, 900px);
				max-height: 86vh;
				padding: 1rem;
				border: 1px solid rgba(255, 255, 255, 0.22);
				border-radius: 16px;
				background: rgb(var(--surface-strong));
				overflow: hidden;
				scrollbar-width: none;
				-ms-overflow-style: none;
				overscroll-behavior: contain;
				cursor: grab;
				touch-action: none;
			}
			:global(.diagram-modal__body.is-zoomed) {
				overflow: auto;
			}
			:global(.diagram-modal__stage) {
				display: grid;
				width: max-content;
				min-width: 100%;
				height: max-content;
				min-height: 100%;
				box-sizing: border-box;
				place-items: center;
			}
			:global(.diagram-modal__body.is-panning) {
				cursor: grabbing;
				user-select: none;
			}
			:global(.diagram-modal__body svg) {
				display: block;
				max-width: none;
				height: auto;
				max-height: none;
			}
			@media (max-width: 720px) {
				:global(.image-modal) {
					width: 94vw;
					height: 82vh;
					padding: 0;
				}
				:global(.image-modal__content img) {
					max-width: none;
				}
				:global(.diagram-modal) {
					padding: 1rem;
				}
				:global(.diagram-modal__body) {
					width: min(94vw, 1040px);
					height: 78vh;
					max-height: 78vh;
				}
				.prose :global(table) {
					display: block;
					overflow-x: auto;
				}
				.prose :global(th),
				.prose :global(td) {
					min-width: 11rem;
				}
			}
			@media (max-width: 1180px) {
				.post-layout {
					width: 100%;
					max-width: 100%;
					padding: 1.5rem;
					grid-template-columns: 180px minmax(0, 1fr);
					gap: 2rem;
				}
				.post-shell {
					display: block;
				}
				.prose {
					margin: auto;
				}
				.post-toc {
					display: none !important;
				}
			}
			@media (max-width: 900px) {
				.post-layout {
					grid-template-columns: 1fr;
					gap: 1.5rem;
					padding: 1.25rem 1rem;
				}
			}
			@media (max-width: 720px) {
				.post-layout {
					padding: 1rem 0.75rem 2rem;
				}
				.prose {
					padding: 1rem 0 3rem;
				}
				.title {
					margin-bottom: 1.5rem;
					padding: 1.25rem 0 1.25rem;
				}
				.title h1 {
					font-size: clamp(1.75rem, 8vw, 2.35rem);
					line-height: 1.3;
					overflow-wrap: anywhere;
				}
				.description {
					font-size: 0.98rem;
					line-height: 1.65;
				}
				.prose :global(pre) {
					max-width: 100%;
					margin-inline: -0.25rem;
					padding: 1rem;
					overflow-x: auto;
					-webkit-overflow-scrolling: touch;
				}
				.prose :global(.image-zoom-frame),
				.prose :global(.mermaid-frame) {
					margin-inline: -0.25rem;
				}
				.related-posts {
					margin-top: 3rem;
				}
				.related-posts__item {
					padding: 1rem 0;
				}
			}
		</style>
	</head>

	<body>
		<div class="reading-progress" aria-hidden="true">
			<span class="reading-progress__bar" data-reading-progress></span>
		</div>
		<Header />
		<div class="site-layout post-layout">
			<GlobalSidebar />
			<main class="post-main">
				<div class="post-shell">
					<article>
						<div class="hero-image">
							{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
						</div>
						<div class="prose" data-pagefind-body>
							<div class="title">
								<div class="date">
									<FormattedDate date={pubDate} relativeDate={createdAt} showTime={showTime} />
									{
										updatedDate && (
											<div class="last-updated-on">
												Last updated on <FormattedDate date={updatedDate} />
											</div>
										)
									}
								</div>
								<h1>{title}</h1>
								<p class="description">{description}</p>
								{
									tags.length > 0 && (
										<div class="tags">
											{tags.map((tag) => (
												<span>{tag}</span>
											))}
										</div>
									)
								}
							</div>
							<slot />
							<section class="comments" data-toc-ignore aria-labelledby="comments-title">
								<p class="comments__eyebrow">Community</p>
								<h2 id="comments-title">댓글</h2>
								<div class="giscus"></div>
							</section>
							<script
								is:inline
								src="https://giscus.app/client.js"
								data-repo="kimgunwooo/blog"
								data-repo-id="R_kgDOTfx2LQ"
								data-category="Announcements"
								data-category-id="DIC_kwDOTfx2Lc4DDx_F"
								data-mapping="pathname"
								data-strict="1"
								data-reactions-enabled="1"
								data-emit-metadata="0"
								data-input-position="bottom"
								data-theme="noborder_light"
								data-lang="ko"
								data-loading="lazy"
								crossorigin="anonymous"
								async
							></script>
							<script is:inline>
								const giscusContainer = document.querySelector('.giscus');
								let giscusFrame;
								const syncGiscusTheme = () => {
									const frame = giscusContainer?.querySelector('iframe.giscus-frame');
									if (!frame) return;
									if (frame !== giscusFrame) {
										giscusFrame = frame;
										frame.addEventListener('load', syncGiscusTheme);
									}
									frame.contentWindow?.postMessage(
										{
											giscus: {
												setConfig: {
													theme:
														document.documentElement.dataset.theme === 'dark'
														? 'noborder_dark'
														: 'noborder_light',
												},
											},
										},
										'https://giscus.app',
									);
								};
								new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
									attributes: true,
									attributeFilter: ['data-theme'],
								});
								new MutationObserver(syncGiscusTheme).observe(giscusContainer, {
									childList: true,
									subtree: true,
								});
									syncGiscusTheme();
							</script>
							{
								relatedPosts.length > 0 && (
									<section class="related-posts" data-toc-ignore aria-labelledby="related-posts-title">
										<p class="related-posts__eyebrow">Related notes</p>
										<h2 id="related-posts-title">같이 보면 좋은 글</h2>
										<div class="related-posts__list">
											{relatedPosts.map((relatedPost) => (
												<a
													class="related-posts__item"
													href={`/blog/${relatedPost.id}/`}
													data-umami-event="related-post-click"
													data-umami-event-post={relatedPost.id}
												>
													<span class="related-posts__meta">
														{relatedPost.data.category} ·{' '}
																	<FormattedDate
																		date={relatedPost.data.pubDate}
																		relativeDate={relatedPost.data.createdAt}
																		showTime={relatedPost.data.showTime}
															/>
													</span>
													<strong>{relatedPost.data.title}</strong>
													<span class="related-posts__description">
														{relatedPost.data.description}
													</span>
												</a>
											))}
										</div>
									</section>
								)
							}
						</div>
					</article>
					<aside class="post-toc" data-post-toc aria-label="글 목차">
						<p class="toc-title">On this page</p>
						<nav class="toc-list" data-toc-list></nav>
					</aside>
				</div>
			</main>
		</div>
		<Footer />
		<script is:inline type="module">
			const prose = document.querySelector('.prose');
			const toc = document.querySelector('[data-post-toc]');
			const tocList = document.querySelector('[data-toc-list]');
			const slugify = (text) =>
				text
					.trim()
					.toLowerCase()
					.replace(/[^\p{Letter}\p{Number}\s-]/gu, '')
					.replace(/\s+/g, '-')
					.replace(/-+/g, '-');

			if (prose && toc && tocList) {
				const headings = [...prose.querySelectorAll('h2, h3')].filter(
					(heading) => !heading.closest('.title, [data-toc-ignore]'),
				);
				const usedIds = new Set();

				headings.forEach((heading) => {
					if (!heading.id) {
						const baseId = slugify(heading.textContent ?? '') || 'section';
						let id = baseId;
						let index = 2;
						while (usedIds.has(id) || document.getElementById(id)) {
							id = `${baseId}-${index}`;
							index += 1;
						}
						heading.id = id;
					}
					usedIds.add(heading.id);

					const link = document.createElement('a');
					link.className = 'toc-link';
					link.href = `#${heading.id}`;
					link.textContent = heading.textContent?.replace(/\s+/g, ' ').trim() ?? '';
					link.dataset.level = heading.tagName === 'H3' ? '3' : '2';
					tocList.append(link);
				});

				if (headings.length > 1) {
					toc.classList.add('is-visible');
				}

				const links = [...tocList.querySelectorAll('a')];
				const setActive = (id) => {
					links.forEach((link) => {
						link.classList.toggle('is-active', link.getAttribute('href') === `#${id}`);
					});
				};
				links.forEach((link) => {
					link.addEventListener('click', () => {
						const targetId = link.getAttribute('href')?.slice(1);
						if (targetId) {
							setActive(targetId);
						}
					});
				});

				const observer = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((entry) => entry.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
						if (visible?.target?.id) {
							setActive(visible.target.id);
						}
					},
					{
						rootMargin: '-18% 0px -70% 0px',
						threshold: 0,
					},
				);

				headings.forEach((heading) => observer.observe(heading));
				if (headings[0]?.id) {
					setActive(headings[0].id);
				}
			}

			if (toc instanceof HTMLElement) {
				let hideTocScrollbarTimer;
				toc.addEventListener(
					'scroll',
					() => {
						toc.classList.add('is-scrolling');
						window.clearTimeout(hideTocScrollbarTimer);
						hideTocScrollbarTimer = window.setTimeout(() => {
							toc.classList.remove('is-scrolling');
						}, 600);
					},
					{ passive: true },
				);
			}

			const readingProgress = document.querySelector('[data-reading-progress]');
			const postArticle = document.querySelector('.post-main article');
			if (readingProgress instanceof HTMLElement && postArticle instanceof HTMLElement) {
				const updateReadingProgress = () => {
					const articleTop = postArticle.getBoundingClientRect().top + window.scrollY;
					const readableHeight = Math.max(postArticle.offsetHeight - window.innerHeight, 1);
					const progress = Math.min(
						Math.max((window.scrollY - articleTop) / readableHeight, 0),
						1,
					);
					readingProgress.style.transform = `scaleX(${progress})`;
				};
				updateReadingProgress();
				window.addEventListener('scroll', updateReadingProgress, { passive: true });
				window.addEventListener('resize', updateReadingProgress);
			}

			const copyIcon = `
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
					<rect x="9" y="9" width="11" height="11" rx="2"></rect>
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
				</svg>`;
			const copiedIcon = `
				<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="m5 12 4 4L19 6"></path>
				</svg>`;
			const writeClipboard = async (text) => {
				try {
					if (navigator.clipboard?.writeText) {
						await navigator.clipboard.writeText(text);
						return;
					}
				} catch {
					// Local or embedded previews can deny Clipboard API access.
				}
				const textarea = document.createElement('textarea');
				textarea.value = text;
				textarea.style.position = 'fixed';
				textarea.style.opacity = '0';
				document.body.append(textarea);
				textarea.select();
				document.execCommand('copy');
				textarea.remove();
			};
			if (prose) {
				[...prose.querySelectorAll('pre')]
					.filter(
						(pre) =>
							!pre.matches('[data-language="mermaid"]') &&
							!pre.querySelector('code.language-mermaid'),
					)
					.forEach((pre) => {
						const code = pre.querySelector('code');
						if (!code) {
							return;
						}
						pre.classList.add('code-block');
						const button = document.createElement('button');
						button.className = 'code-copy';
						button.type = 'button';
						button.setAttribute('aria-label', '코드 복사');
						button.title = '코드 복사';
						button.innerHTML = copyIcon;
						button.addEventListener('click', async () => {
							try {
								await writeClipboard(code.textContent ?? '');
								button.dataset.copied = 'true';
								button.setAttribute('aria-label', '복사됨');
								button.title = '복사됨';
								button.innerHTML = copiedIcon;
								window.setTimeout(() => {
									delete button.dataset.copied;
									button.setAttribute('aria-label', '코드 복사');
									button.title = '코드 복사';
									button.innerHTML = copyIcon;
								}, 1400);
							} catch {
								button.setAttribute('aria-label', '복사 실패');
								button.title = '복사 실패';
							}
						});

						const wrapper = document.createElement('div');
						wrapper.className = 'code-block-wrap';
						pre.parentNode?.insertBefore(wrapper, pre);
						wrapper.append(pre, button);
					});
			}

			const imageModal = document.createElement('dialog');
			imageModal.className = 'image-modal';
			imageModal.innerHTML = `
				<div class="image-modal__bar">
					<span class="image-modal__hint">Ctrl/⌘ + 휠 또는 버튼으로 확대</span>
					<button class="image-modal__zoom-button" type="button" data-image-action="zoom-out" aria-label="이미지 축소">−</button>
					<button class="image-modal__zoom-button image-modal__zoom-button--fit" type="button" data-image-action="fit" aria-label="이미지 화면에 맞추기">맞춤</button>
					<button class="image-modal__zoom-button" type="button" data-image-action="zoom-in" aria-label="이미지 확대">+</button>
					<button class="image-modal__zoom-button image-modal__zoom-button--fit" type="button" data-image-action="reset" aria-label="이미지 원래 크기">100%</button>
					<button class="image-modal__close" type="button" aria-label="이미지 닫기">×</button>
				</div>
				<div class="image-modal__content"><div class="image-modal__stage"></div></div>
			`;
			document.body.append(imageModal);
			const imageModalContent = imageModal.querySelector('.image-modal__content');
			const imageModalStage = imageModal.querySelector('.image-modal__stage');
			let activeImage = null;
			let imageBaseWidth = 0;
			let imageBaseHeight = 0;
			let imageZoom = 1;
			let imageFitZoom = 1;
			let imagePanStart = null;
			const clampImageZoom = (value) => Math.min(Math.max(value, 0.1), 16);
			const updateImageZoom = (nextZoom, anchor = null) => {
				if (!(activeImage instanceof HTMLImageElement) || !imageBaseWidth || !imageBaseHeight) {
					return;
				}
				const contentRect = imageModalContent?.getBoundingClientRect();
				const anchorX = anchor?.x ?? (contentRect ? contentRect.left + contentRect.width / 2 : 0);
				const anchorY = anchor?.y ?? (contentRect ? contentRect.top + contentRect.height / 2 : 0);
				const localX = contentRect ? anchorX - contentRect.left : 0;
				const localY = contentRect ? anchorY - contentRect.top : 0;
				const previousZoom = imageZoom;
				imageZoom = clampImageZoom(nextZoom);
				imageModalContent?.classList.toggle('is-zoomed', imageZoom > imageFitZoom * 1.01);
				activeImage.style.width = `${Math.round(imageBaseWidth * imageZoom)}px`;
				activeImage.style.height = `${Math.round(imageBaseHeight * imageZoom)}px`;
				if (imageModalContent && contentRect && previousZoom > 0) {
					const scale = imageZoom / previousZoom;
					imageModalContent.scrollLeft = (imageModalContent.scrollLeft + localX) * scale - localX;
					imageModalContent.scrollTop = (imageModalContent.scrollTop + localY) * scale - localY;
				}
			};
			const resizeImageModal = () => {
				if (!imageBaseWidth || !imageBaseHeight) {
					return;
				}
				const maxWidth = Math.min(window.innerWidth * 0.94, 1500);
				const maxHeight = Math.min(window.innerHeight * 0.86, 1000);
				imageModal.style.width = `${maxWidth}px`;
				imageModal.style.height = `${maxHeight}px`;
			};
			const fitImage = () => {
				if (!(activeImage instanceof HTMLImageElement) || !imageModalContent || !imageBaseWidth || !imageBaseHeight) {
					return;
				}
				const availableWidth = imageModalContent.clientWidth - 32;
				const availableHeight = imageModalContent.clientHeight - 32;
				imageFitZoom = clampImageZoom(Math.min(availableWidth / imageBaseWidth, availableHeight / imageBaseHeight));
				updateImageZoom(imageFitZoom);
				imageModalContent.scrollTo({ left: 0, top: 0 });
			};
			const getImageSize = (image, fallback) => {
				const naturalWidth = image.naturalWidth || 0;
				const naturalHeight = image.naturalHeight || 0;
				if (naturalWidth && naturalHeight) {
					return { width: naturalWidth, height: naturalHeight };
				}
				const rect = image.getBoundingClientRect();
				return {
					width: rect.width || fallback.width,
					height: rect.height || fallback.height,
				};
			};
			const closeImageModal = () => imageModal.close();
			const resetImageViewer = () => {
				activeImage = null;
				imageBaseWidth = 0;
				imageBaseHeight = 0;
				imageZoom = 1;
				imageFitZoom = 1;
				imagePanStart = null;
				imageModalContent?.classList.remove('is-panning');
				imageModalContent?.classList.remove('is-zoomed');
				imageModalStage?.replaceChildren();
				imageModal.style.width = '';
				imageModal.style.height = '';
			};
			imageModal.querySelector('.image-modal__close')?.addEventListener('click', closeImageModal);
			imageModal.addEventListener('close', resetImageViewer);
			imageModal.querySelector('[data-image-action="zoom-out"]')?.addEventListener('click', () => {
				updateImageZoom(imageZoom / 1.25);
			});
			imageModal.querySelector('[data-image-action="zoom-in"]')?.addEventListener('click', () => {
				updateImageZoom(imageZoom * 1.25);
			});
			imageModal.querySelector('[data-image-action="fit"]')?.addEventListener('click', fitImage);
			imageModal.querySelector('[data-image-action="reset"]')?.addEventListener('click', () => {
				updateImageZoom(1);
			});
			imageModal.addEventListener('click', (event) => {
				if (event.target === imageModal) {
					closeImageModal();
				}
			});
			imageModalContent?.addEventListener(
				'wheel',
				(event) => {
					if (!event.ctrlKey && !event.metaKey) {
						return;
					}
					event.preventDefault();
					updateImageZoom(imageZoom * (event.deltaY < 0 ? 1.15 : 1 / 1.15), {
						x: event.clientX,
						y: event.clientY,
					});
				},
				{ passive: false },
			);
			imageModalContent?.addEventListener('pointerdown', (event) => {
				if (!(event.target instanceof Element) || !event.target.closest('img')) {
					return;
				}
				imagePanStart = {
					x: event.clientX,
					y: event.clientY,
					left: imageModalContent.scrollLeft,
					top: imageModalContent.scrollTop,
				};
				imageModalContent.classList.add('is-panning');
				imageModalContent.setPointerCapture(event.pointerId);
			});
			imageModalContent?.addEventListener('pointermove', (event) => {
				if (!imagePanStart || !imageModalContent) {
					return;
				}
				imageModalContent.scrollLeft = imagePanStart.left - (event.clientX - imagePanStart.x);
				imageModalContent.scrollTop = imagePanStart.top - (event.clientY - imagePanStart.y);
			});
			const stopImagePan = (event) => {
				if (!imagePanStart || !imageModalContent) {
					return;
				}
				imagePanStart = null;
				imageModalContent.classList.remove('is-panning');
				if (imageModalContent.hasPointerCapture(event.pointerId)) {
					imageModalContent.releasePointerCapture(event.pointerId);
				}
			};
			imageModalContent?.addEventListener('pointerup', stopImagePan);
			imageModalContent?.addEventListener('pointercancel', stopImagePan);
			window.addEventListener('resize', () => {
				if (imageModal.open) {
					resizeImageModal();
					fitImage();
				}
			});

			if (prose) {
				const expandIcon = `
					<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
						<path d="M15 3h6v6"></path><path d="M21 3l-7 7"></path>
						<path d="M9 21H3v-6"></path><path d="M3 21l7-7"></path>
					</svg>`;
				const createImageButton = (image, index) => {
					const button = document.createElement('button');
					button.className = 'image-zoom-button';
					button.type = 'button';
					button.setAttribute('aria-label', '이미지 크게 보기');
					button.title = '이미지 크게 보기';
					button.innerHTML = expandIcon;
					const openImageModal = () => {
						const expandedImage = image.cloneNode(true);
						expandedImage.removeAttribute('loading');
						expandedImage.removeAttribute('width');
						expandedImage.removeAttribute('height');
						expandedImage.alt = image.alt || `본문 이미지 ${index + 1}`;
						activeImage = expandedImage;
						imageZoom = 1;
						imageModalStage?.replaceChildren(expandedImage);
						resizeImageModal();
						imageModal.showModal();
						requestAnimationFrame(() => {
							const size = getImageSize(expandedImage, {
								width: image.clientWidth,
								height: image.clientHeight,
							});
							imageBaseWidth = size.width;
							imageBaseHeight = size.height;
							fitImage();
						});
					};
					button.addEventListener('click', (event) => {
						event.preventDefault();
						event.stopPropagation();
						openImageModal();
					});
					image.addEventListener('click', openImageModal);
					return button;
				};

				[...prose.querySelectorAll('img')].forEach((image, index) => {
					if (image.closest('.image-zoom-frame')) {
						return;
					}
					let frame = image.closest('figure');
					if (!(frame instanceof HTMLElement) || frame.closest('.prose') !== prose) {
						const paragraph = image.parentElement;
						frame = document.createElement('figure');
						frame.className = 'image-zoom-frame';
						if (paragraph instanceof HTMLParagraphElement) {
							paragraph.replaceWith(frame);
						} else {
							image.parentNode?.insertBefore(frame, image);
						}
						frame.append(image);
					}
					frame.classList.add('image-zoom-frame');
					frame.append(createImageButton(image, index));
				});
			}

			const mermaidBlocks = [
				...document.querySelectorAll('pre[data-language="mermaid"], pre > code.language-mermaid'),
			];
			if (mermaidBlocks.length > 0) {
				const { default: mermaid } = await import(
					'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs'
				);
				mermaid.initialize({
					startOnLoad: false,
					theme: 'base',
					securityLevel: 'loose',
					flowchart: {
						htmlLabels: true,
						curve: 'basis',
						nodeSpacing: 58,
						rankSpacing: 72,
						padding: 18,
						wrappingWidth: 180,
					},
					themeVariables: {
						background: '#ffffff',
						mainBkg: '#f8fafc',
						primaryColor: '#eef6ff',
						primaryTextColor: '#111827',
						primaryBorderColor: '#174a7c',
						secondaryColor: '#f8fafc',
						secondaryBorderColor: '#94a3b8',
						tertiaryColor: '#ffffff',
						tertiaryBorderColor: '#d8e1ec',
						clusterBkg: '#f8fafc',
						clusterBorder: '#d8e1ec',
						lineColor: '#64748b',
						defaultLinkColor: '#64748b',
						edgeLabelBackground: '#ffffff',
						textColor: '#1f2937',
						titleColor: '#111827',
						nodeTextColor: '#111827',
						fontSize: '15px',
						fontFamily:
							'-apple-system, BlinkMacSystemFont, "Segoe UI", "Apple SD Gothic Neo", "Noto Sans KR", sans-serif',
					},
				});

				mermaidBlocks.forEach((block) => {
					const source = block.textContent ?? '';
					const frame = document.createElement('figure');
					frame.className = 'mermaid-frame';
					const canvas = document.createElement('div');
					canvas.className = 'mermaid-canvas';
					const container = document.createElement('div');
					container.className = 'mermaid';
					container.textContent = source;
					canvas.append(container);
					frame.append(canvas);
					const target = block instanceof HTMLPreElement ? block : block.closest('pre');
					target?.replaceWith(frame);
				});

				await mermaid.run({
					nodes: document.querySelectorAll('.mermaid'),
				});

				// Keep compact diagrams within the article width. Only preserve the native
				// width of genuinely wide diagrams so their labels remain readable.
				document.querySelectorAll('.mermaid-frame').forEach((frame) => {
					const canvas = frame.querySelector('.mermaid-canvas');
					const svg = frame.querySelector('.mermaid svg');
					const viewBox = svg instanceof SVGElement ? svg.viewBox.baseVal : null;
					if (!(canvas instanceof HTMLElement) || !viewBox?.width) {
						return;
					}

					const canvasStyle = window.getComputedStyle(canvas);
					const availableWidth =
						canvas.clientWidth -
						Number.parseFloat(canvasStyle.paddingLeft) -
						Number.parseFloat(canvasStyle.paddingRight);

					if (viewBox.width > availableWidth * 1.2) {
						svg.style.width = `${Math.ceil(viewBox.width)}px`;
						svg.style.maxWidth = 'none';
					}
				});

				const modal = document.createElement('div');
				modal.className = 'diagram-modal';
				modal.hidden = true;
				modal.innerHTML = `
					<div class="diagram-modal__bar">
						<span class="diagram-modal__hint">Ctrl/⌘ + 휠 또는 버튼으로 확대</span>
						<button class="diagram-modal__zoom-button" type="button" data-diagram-action="zoom-out" aria-label="다이어그램 축소">−</button>
						<button class="diagram-modal__zoom-button diagram-modal__zoom-button--fit" type="button" data-diagram-action="fit" aria-label="다이어그램 화면에 맞추기">맞춤</button>
						<button class="diagram-modal__zoom-button" type="button" data-diagram-action="zoom-in" aria-label="다이어그램 확대">+</button>
						<button class="diagram-modal__zoom-button diagram-modal__zoom-button--fit" type="button" data-diagram-action="reset" aria-label="다이어그램 원래 크기">100%</button>
						<button class="diagram-modal__close" type="button" aria-label="다이어그램 닫기">×</button>
					</div>
					<div class="diagram-modal__body">
						<div class="diagram-modal__stage" role="document"></div>
					</div>
				`;
				document.body.append(modal);

				const modalBody = modal.querySelector('.diagram-modal__body');
				const modalStage = modal.querySelector('.diagram-modal__stage');
				let activeDiagram = null;
				let baseWidth = 0;
				let baseHeight = 0;
				let zoom = 1;
				let fitZoom = 1;
				let panStart = null;
				const clampZoom = (value) => Math.min(Math.max(value, 0.25), 6);
				const updateZoom = (nextZoom) => {
					if (!(activeDiagram instanceof SVGElement) || !baseWidth || !baseHeight) {
						return;
					}
					zoom = clampZoom(nextZoom);
					modalBody?.classList.toggle('is-zoomed', zoom > fitZoom * 1.01);
					activeDiagram.style.width = `${Math.round(baseWidth * zoom)}px`;
					activeDiagram.style.height = `${Math.round(baseHeight * zoom)}px`;
				};
				const resizeModal = () => {
					if (!modalBody || !baseWidth || !baseHeight) {
						return;
					}
					const maxWidth = Math.min(window.innerWidth * 0.94, 1440);
					const maxHeight = Math.min(window.innerHeight * 0.86, 900);
					modalBody.style.width = `${maxWidth}px`;
					modalBody.style.height = `${maxHeight}px`;
				};
				const fitDiagram = () => {
					if (!(activeDiagram instanceof SVGElement) || !modalBody || !baseWidth || !baseHeight) {
						return;
					}
					const availableWidth = modalBody.clientWidth - 32;
					const availableHeight = modalBody.clientHeight - 32;
					fitZoom = clampZoom(Math.min(availableWidth / baseWidth, availableHeight / baseHeight));
					updateZoom(fitZoom);
					modalBody.scrollTo({ left: 0, top: 0 });
				};
				const closeModal = () => {
					modal.hidden = true;
					modalStage?.replaceChildren();
					if (modalBody) {
						modalBody.style.width = '';
						modalBody.style.height = '';
						modalBody.classList.remove('is-zoomed');
					}
					activeDiagram = null;
					baseWidth = 0;
					baseHeight = 0;
					zoom = 1;
					fitZoom = 1;
					document.body.style.overflow = '';
				};
				modal.querySelector('.diagram-modal__close')?.addEventListener('click', closeModal);
				modal.querySelector('[data-diagram-action="zoom-out"]')?.addEventListener('click', () => {
					updateZoom(zoom / 1.25);
				});
				modal.querySelector('[data-diagram-action="zoom-in"]')?.addEventListener('click', () => {
					updateZoom(zoom * 1.25);
				});
				modal.querySelector('[data-diagram-action="fit"]')?.addEventListener('click', fitDiagram);
				modal.querySelector('[data-diagram-action="reset"]')?.addEventListener('click', () => {
					updateZoom(1);
				});
				modal.addEventListener('click', (event) => {
					const target = event.target;
					if (
						target instanceof Element &&
						!target.closest('.diagram-modal__body, .diagram-modal__bar')
					) {
						closeModal();
					}
				});
				modalBody?.addEventListener(
					'wheel',
					(event) => {
						if (!event.ctrlKey && !event.metaKey) {
							return;
						}
						event.preventDefault();
						updateZoom(zoom * (event.deltaY < 0 ? 1.15 : 1 / 1.15));
					},
					{ passive: false },
				);
				modalBody?.addEventListener('pointerdown', (event) => {
					if (!(event.target instanceof Element) || !event.target.closest('svg')) {
						return;
					}
					panStart = {
						x: event.clientX,
						y: event.clientY,
						left: modalBody.scrollLeft,
						top: modalBody.scrollTop,
					};
					modalBody.classList.add('is-panning');
					modalBody.setPointerCapture(event.pointerId);
				});
				modalBody?.addEventListener('pointermove', (event) => {
					if (!panStart) {
						return;
					}
					modalBody.scrollLeft = panStart.left - (event.clientX - panStart.x);
					modalBody.scrollTop = panStart.top - (event.clientY - panStart.y);
				});
				const stopPan = (event) => {
					if (!panStart || !modalBody) {
						return;
					}
					panStart = null;
					modalBody.classList.remove('is-panning');
					if (modalBody.hasPointerCapture(event.pointerId)) {
						modalBody.releasePointerCapture(event.pointerId);
					}
				};
				modalBody?.addEventListener('pointerup', stopPan);
				modalBody?.addEventListener('pointercancel', stopPan);
				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && !modal.hidden) {
						closeModal();
					}
				});
				window.addEventListener('resize', () => {
					if (!modal.hidden) {
						resizeModal();
						fitDiagram();
					}
				});

				document.querySelectorAll('.mermaid-frame').forEach((frame, index) => {
					const svg = frame.querySelector('.mermaid svg');
					if (!svg) {
						return;
					}
					const button = document.createElement('button');
					button.className = 'mermaid-expand';
					button.type = 'button';
					button.setAttribute('aria-label', '다이어그램 크게 보기');
					button.textContent = '⤢';
					button.addEventListener('click', (event) => {
						event.preventDefault();
						event.stopPropagation();
						const clone = svg.cloneNode(true);
						clone.removeAttribute('style');
						clone.setAttribute('aria-label', `diagram-${index + 1}`);
						activeDiagram = clone;
						const viewBox = clone.viewBox.baseVal;
						baseWidth = viewBox.width || Number.parseFloat(clone.getAttribute('width') ?? '') || svg.clientWidth;
						baseHeight = viewBox.height || Number.parseFloat(clone.getAttribute('height') ?? '') || svg.clientHeight;
						zoom = 1;
						modalStage?.replaceChildren(clone);
						resizeModal();
						modal.hidden = false;
						document.body.style.overflow = 'hidden';
						requestAnimationFrame(fitDiagram);
					});
					frame.append(button);
				});
			}
		</script>
	</body>
</html>
