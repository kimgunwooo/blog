---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GlobalSidebar from '../components/GlobalSidebar.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.post-main {
				min-width: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 100%;
				max-width: 760px;
				margin: auto;
				padding: 2rem 0 4rem;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 2rem;
				padding: 2rem 0 1.5rem;
				border-bottom: 1px solid rgb(var(--line));
				line-height: 1.25;
			}
			.title h1 {
				margin: 0 0 0.65rem;
				font-size: clamp(2rem, 6vw, 3.2rem);
			}
			.description {
				max-width: 680px;
				margin: 0;
				color: rgb(var(--muted));
				font-size: 1.05rem;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--accent);
				font-size: 0.88rem;
				font-weight: 700;
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 1rem;
			}
			.tags span {
				padding: 0.25rem 0.5rem;
				background: rgb(var(--surface));
				border: 1px solid rgb(var(--line));
				border-radius: 999px;
				color: rgb(var(--muted));
				font-size: 0.78rem;
			}
			.prose :global(h2) {
				margin-top: 2.2rem;
				font-size: 1.55rem;
			}
			.prose :global(h3) {
				margin-top: 1.75rem;
			}
			.prose :global(li) {
				margin-bottom: 0.35rem;
			}
			.prose :global(table) {
				width: 100%;
				margin: 1.25rem 0 1.75rem;
				border: 1px solid rgb(var(--line));
				border-collapse: separate;
				border-spacing: 0;
				border-radius: 10px;
				background: #fff;
				box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
				font-size: 0.93rem;
				line-height: 1.55;
				overflow: hidden;
			}
			.prose :global(thead) {
				background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
			}
			.prose :global(th),
			.prose :global(td) {
				padding: 0.85rem 1rem;
				border-bottom: 1px solid rgb(var(--line));
				text-align: left;
				vertical-align: top;
			}
			.prose :global(th + th),
			.prose :global(td + td) {
				border-left: 1px solid rgb(var(--line));
			}
			.prose :global(th) {
				color: rgb(var(--black));
				font-weight: 800;
				white-space: nowrap;
			}
			.prose :global(tbody tr:nth-child(even)) {
				background: rgb(var(--surface) / 0.55);
			}
			.prose :global(td:first-child) {
				width: 13rem;
				white-space: nowrap;
			}
			.prose :global(tr:last-child td) {
				border-bottom: 0;
			}
			.prose :global(td code) {
				font-size: 0.9em;
				font-weight: 700;
			}
			@media (max-width: 720px) {
				.prose :global(table) {
					display: block;
					overflow-x: auto;
				}
				.prose :global(th),
				.prose :global(td) {
					min-width: 11rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main class="post-main">
				<article>
					<div class="hero-image">
						{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
					</div>
					<div class="prose" data-pagefind-body>
						<div class="title">
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1>{title}</h1>
							<p class="description">{description}</p>
							{
								tags.length > 0 && (
									<div class="tags">
										{tags.map((tag) => (
											<span>{tag}</span>
										))}
									</div>
								)
							}
						</div>
						<slot />
					</div>
				</article>
			</main>
		</div>
		<Footer />
	</body>
</html>
