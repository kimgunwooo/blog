---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import GlobalSidebar from '../../components/GlobalSidebar.astro';
import Header from '../../components/Header.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION } from '../../consts';

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const post of posts) {
	counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="Categories | DevOps Journey" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main>
				<section class="page-title">
					<p class="eyebrow">Categories</p>
					<h1>학습 흐름별로 보기</h1>
					<p>Docker에서 시작해 Network, Kubernetes, Cloud 운영으로 확장해가며 정리합니다.</p>
				</section>
				<section class="category-list">
					{
						BLOG_CATEGORIES.map((category) => (
							<a class="category-row" href={`/categories/${category.slug}/`}>
								<div>
									<h2>{category.label}</h2>
									<p>{category.description}</p>
								</div>
								<span>{counts.get(category.label) ?? 0} notes</span>
							</a>
						))
					}
				</section>
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		padding: 2rem 0 1.75rem;
		border-bottom: 1px solid rgb(var(--line));
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.page-title p:last-child {
		color: rgb(var(--muted));
	}
	.category-list {
		display: grid;
		border-top: 1px solid rgb(var(--line));
		margin-top: 2.25rem;
	}
	.category-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: start;
		padding: 1.15rem 0;
		border-bottom: 1px solid rgb(var(--line));
		color: inherit;
		text-decoration: none;
	}
	.category-row h2 {
		margin: 0 0 0.35rem;
		font-size: 1.35rem;
	}
	.category-row p {
		max-width: 650px;
		margin: 0;
		color: rgb(var(--muted));
	}
	.category-row > span {
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.category-row:hover h2 {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.category-row {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
