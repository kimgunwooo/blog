---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION } from '../../consts';

const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const post of posts) {
	counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="Categories | DevOps Journey" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="page-title">
				<p class="eyebrow">Categories</p>
				<h1>학습 흐름별로 보기</h1>
				<p>Docker에서 시작해 Network, Kubernetes, Cloud 운영으로 확장해가며 정리합니다.</p>
			</section>
			<section class="category-grid">
				{
					BLOG_CATEGORIES.map((category) => (
						<a class="category-card" href={`/categories/${category.slug}/`}>
							<div>
								<p class="count">{counts.get(category.label) ?? 0} notes</p>
								<h2>{category.label}</h2>
								<p>{category.description}</p>
							</div>
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		padding: 3rem 0 2rem;
		border-bottom: 1px solid rgb(var(--line));
	}
	.eyebrow,
	.count {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.page-title p:last-child {
		color: rgb(var(--muted));
	}
	.category-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		padding: 2rem 0;
	}
	.category-card {
		display: block;
		min-height: 210px;
		padding: 1.25rem;
		background: rgb(var(--surface));
		border: 1px solid rgb(var(--line));
		border-radius: 8px;
		color: inherit;
		text-decoration: none;
	}
	.category-card h2 {
		margin-bottom: 0.75rem;
		font-size: 1.5rem;
	}
	.category-card p:not(.count) {
		color: rgb(var(--muted));
	}
	.category-card:hover h2 {
		color: var(--accent);
	}
	@media (max-width: 900px) {
		.category-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 720px) {
		.category-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
