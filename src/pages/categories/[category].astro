---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import GlobalSidebar from '../../components/GlobalSidebar.astro';
import Header from '../../components/Header.astro';
import PostCards from '../../components/PostCards.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	return BLOG_CATEGORIES.map((category) => ({
		params: { category: category.slug },
		props: category,
	}));
}

const category = Astro.props;
const posts = (await getCollection('blog'))
	.filter((post) => post.data.category === category.label)
	.sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${category.label} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main class="notes-main">
				<section class="page-title">
					<p class="eyebrow">Topic</p>
					<h1>{category.label}</h1>
					<p>{category.description}</p>
				</section>
				<div class="summary-line">
					<span>{posts.length} notes</span>
					<a href="/blog/">전체 글 보기</a>
				</div>
				<PostCards posts={posts} layout="home" showCategory={false} />
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		padding: 2rem 0 1.5rem;
		border-bottom: 1px solid rgb(var(--line));
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.page-title p:last-child {
		max-width: 680px;
		color: rgb(var(--muted));
	}
	.summary-line {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.15rem 0;
		color: rgb(var(--muted));
		font-size: 0.9rem;
	}
	.summary-line span {
		color: var(--accent);
		font-weight: 800;
	}
	.summary-line a {
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
	}
	@media (max-width: 720px) {
		.summary-line {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.35rem;
		}
	}
</style>
