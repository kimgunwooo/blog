---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GlobalSidebar from '../components/GlobalSidebar.astro';
import Header from '../components/Header.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const categoryCounts = new Map<string, number>();
for (const post of await getCollection('blog')) {
	categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) ?? 0) + 1);
}
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main>
				<section class="hero">
					<div class="terminal-hero" data-terminal aria-label="DevOps Journey 터미널 히어로">
						<div class="terminal-top">
							<span></span>
							<span></span>
							<span></span>
							<strong>codex ~/devops-journey</strong>
						</div>
						<div class="terminal-body">
							<p class="terminal-command">
								<span class="prompt">$</span>
								<span
									class="typed-command"
									data-terminal-command="notes open --path docker/network/kubernetes/cloud"
								></span>
								<span class="command-cursor" aria-hidden="true"></span>
							</p>
							<pre class="terminal-ascii" aria-hidden="true"><code data-terminal-ascii>██████╗ ███████╗██╗   ██╗ ██████╗ ██████╗ ███████╗
██╔══██╗██╔════╝██║   ██║██╔═══██╗██╔══██╗██╔════╝
██║  ██║█████╗  ██║   ██║██║   ██║██████╔╝███████╗
██║  ██║██╔══╝  ╚██╗ ██╔╝██║   ██║██╔═══╝ ╚════██║
██████╔╝███████╗ ╚████╔╝ ╚██████╔╝██║     ███████║
╚═════╝ ╚══════╝  ╚═══╝   ╚═════╝ ╚═╝     ╚══════╝

       Journey through Docker, Network, Kubernetes and Cloud</code></pre>
							<div class="terminal-lines">
								<p data-terminal-line><span class="prompt">></span> 직접 막힌 지점을 기록하고, 작은 실험으로 다시 확인합니다.</p>
								<p data-terminal-line><span class="prompt">></span> Docker layer, network, GitOps, observability를 연결해서 정리합니다.</p>
								<p data-terminal-line><span class="prompt">></span> Velog에는 완성된 글을, 이곳에는 실험 과정과 기준을 남깁니다.<span class="cursor" aria-hidden="true"></span></p>
							</div>
							<div class="terminal-feed" aria-hidden="true">
								<p data-terminal-feed><span>[watch]</span> docker/buildkit-cache.md indexed</p>
								<p data-terminal-feed><span>[sync]</span> kubernetes/gitops-note.md refreshed</p>
								<p data-terminal-feed><span>[check]</span> observability/loss-boundary.md queued</p>
							</div>
						</div>
					</div>
				</section>

				<section class="section-block">
					<div class="section-heading">
						<p class="eyebrow">Technical Notes</p>
						<h2>최근 기록</h2>
					</div>
					<div class="note-list">
						{
							posts.map((post) => (
								<a class="note-row" href={`/blog/${post.id}/`}>
									<div>
										<p class="note-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
									<div class="tags">
										{post.data.tags.map((tag) => (
											<span>{tag}</span>
										))}
									</div>
								</a>
							))
						}
					</div>
				</section>

				<section class="section-block">
					<div class="section-heading">
						<p class="eyebrow">Topics</p>
						<h2>요즘 정리하는 것</h2>
					</div>
					<div class="topic-list">
						{
							BLOG_CATEGORIES.map((item) => (
								<a class="topic-row" href={`/categories/${item.slug}/`}>
									<div>
										<h3>{item.label}</h3>
										<p>{item.description}</p>
									</div>
									<span>{categoryCounts.get(item.label) ?? 0} notes</span>
								</a>
							))
						}
					</div>
				</section>

				<section class="why-card">
					<p class="eyebrow">Why Here</p>
					<h2>Velog에는 정리된 글, 이곳에는 실험 기록</h2>
					<div class="why-grid">
						<div>
							<strong>Velog</strong>
							<p>읽기 좋게 다듬은 공개 글과 회고를 올립니다.</p>
						</div>
						<div>
							<strong>DevOps Journey</strong>
							<p>실험 조건, 실패한 가정, 재검증 기준처럼 다시 봐야 할 운영 노트를 남깁니다.</p>
						</div>
						<div>
							<strong>Home Kubernetes</strong>
							<p>블로그 자체를 배포하며 GitOps, 모니터링, 알림을 하나씩 붙여갑니다.</p>
						</div>
					</div>
				</section>
			</main>
		</div>
		<Footer />
		<script>
			const terminal = document.querySelector('[data-terminal]');
			const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

			if (terminal) {
				const command = terminal.querySelector('[data-terminal-command]');
				const ascii = terminal.querySelector('[data-terminal-ascii]');
				if (!command || !ascii) {
					throw new Error('Terminal hero markup is incomplete.');
				}
				const asciiText = ascii?.textContent ?? '';
				const lines = [...terminal.querySelectorAll('[data-terminal-line]')];
				const feeds = [...terminal.querySelectorAll('[data-terminal-feed]')];
				let feedTimer;

				const resetTerminal = () => {
					window.clearInterval(feedTimer);
					command.textContent = '';
					ascii.textContent = '';
					terminal.classList.add('is-booting');
					terminal.classList.remove('is-ready');
					terminal.querySelector('.terminal-ascii')?.classList.remove('is-visible');
					terminal.querySelector('.terminal-lines')?.classList.remove('is-visible');
					terminal.querySelector('.terminal-feed')?.classList.remove('is-visible');
					lines.forEach((line) => line.classList.remove('is-visible'));
					feeds.forEach((feed) => feed.classList.remove('is-active'));
				};

				const bootTerminal = async () => {
					resetTerminal();
					const commandText = command.dataset.terminalCommand ?? '';

					await sleep(260);
					for (const char of commandText) {
						command.textContent += char;
						await sleep(26);
					}

					await sleep(180);
					terminal.querySelector('.terminal-ascii')?.classList.add('is-visible');
					const asciiLines = asciiText.split('\n');
					for (const line of asciiLines) {
						ascii.textContent += `${line}\n`;
						await sleep(55);
					}

					await sleep(220);
					terminal.querySelector('.terminal-lines')?.classList.add('is-visible');
					for (const line of lines) {
						line.classList.add('is-visible');
						await sleep(260);
					}

					await sleep(180);
					terminal.querySelector('.terminal-feed')?.classList.add('is-visible');
					terminal.classList.remove('is-booting');
					terminal.classList.add('is-ready');

					let activeIndex = 0;
					feedTimer = window.setInterval(() => {
						feeds.forEach((feed, index) => {
							feed.classList.toggle('is-active', index === activeIndex);
						});
						activeIndex = (activeIndex + 1) % Math.max(feeds.length, 1);
					}, 1100);
				};

				bootTerminal();
				window.addEventListener('pageshow', (event) => {
					if (event.persisted) {
						bootTerminal();
					}
				});
			}
		</script>
	</body>
</html>

<style>
	.hero {
		padding: 2.25rem 0 2.5rem;
		border-bottom: 1px solid rgb(var(--line));
	}
	.eyebrow,
	.label,
	.note-date {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}
	.terminal-hero {
		position: relative;
		overflow: hidden;
		width: 100%;
		background: #090d1a;
		border: 1px solid rgba(15, 23, 42, 0.18);
		border-radius: 13px;
		box-shadow: 0 18px 44px rgba(15, 23, 42, 0.14);
	}
	.terminal-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(rgba(255, 255, 255, 0.025) 50%, transparent 50%);
		background-size: 100% 4px;
		opacity: 0.35;
		pointer-events: none;
	}
	.terminal-top {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.85rem 1rem;
		background: #0f1526;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.terminal-top span {
		width: 11px;
		height: 11px;
		border-radius: 999px;
	}
	.terminal-top span:nth-child(1) {
		background: #ff5f57;
	}
	.terminal-top span:nth-child(2) {
		background: #ffbd2e;
	}
	.terminal-top span:nth-child(3) {
		background: #28c840;
	}
	.terminal-top strong {
		margin-left: 0.35rem;
		color: #9aa8bd;
		font-size: 0.76rem;
		font-weight: 800;
	}
	.terminal-body {
		position: relative;
		z-index: 1;
		padding: 1.35rem 1.45rem 1.5rem;
		color: #d8e2ee;
		font-family:
			'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
	}
	.terminal-command {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0 0 1rem;
		color: #7dd3fc;
		font-size: 0.88rem;
		white-space: nowrap;
	}
	.typed-command {
		display: inline-block;
		overflow: hidden;
		min-width: 1ch;
		max-width: 100%;
	}
	.command-cursor {
		display: inline-block;
		width: 8px;
		height: 1.2em;
		background: #7dd3fc;
		animation: cursor-blink 0.8s steps(2, start) infinite;
	}
	.terminal-body pre {
		margin: 0;
		padding: 0 0 1.15rem;
		background: transparent;
		color: #d8e2ee;
		font-size: 0.68rem;
		line-height: 1.18;
		overflow-x: auto;
	}
	.terminal-ascii {
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}
	.terminal-ascii.is-visible {
		opacity: 1;
		transform: translateY(0);
	}
	.terminal-body code {
		padding: 0;
		background: transparent;
		color: inherit;
	}
	.terminal-lines {
		display: grid;
		gap: 0.35rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(216, 226, 238, 0.72);
		opacity: 0;
		transform: translateY(5px);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}
	.terminal-lines.is-visible {
		opacity: 1;
		transform: translateY(0);
	}
	.terminal-lines p {
		margin: 0;
		color: #aebdd1;
		font-size: 0.86rem;
		line-height: 1.75;
		opacity: 0;
		transform: translateY(5px);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}
	.terminal-lines p.is-visible {
		opacity: 1;
		transform: translateY(0);
	}
	.terminal-feed {
		display: grid;
		gap: 0.25rem;
		margin-top: 1rem;
		padding-top: 0.85rem;
		border-top: 1px dashed rgba(216, 226, 238, 0.26);
		color: #8393aa;
		font-size: 0.78rem;
		opacity: 0;
		transform: translateY(5px);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}
	.terminal-feed.is-visible {
		opacity: 1;
		transform: translateY(0);
	}
	.terminal-feed p {
		margin: 0;
		opacity: 0.36;
		transform: translateX(0);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}
	.terminal-feed span {
		color: #7dd3fc;
	}
	.terminal-feed p.is-active {
		opacity: 1;
		transform: translateX(6px);
	}
	.prompt {
		color: #22c55e;
		font-weight: 800;
		margin-right: 0.2rem;
	}
	.cursor {
		display: inline-block;
		width: 8px;
		height: 1.1em;
		margin-left: 0.25rem;
		background: #22c55e;
		vertical-align: -0.2em;
		animation: cursor-blink 1s steps(2, start) infinite;
	}
	@keyframes cursor-blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.terminal-ascii,
		.terminal-lines,
		.terminal-feed,
		.terminal-lines p,
		.terminal-feed p {
			transition: none;
		}
		.command-cursor,
		.cursor {
			animation: none;
		}
	}
	@media (max-width: 720px) {
		.terminal-body {
			padding: 1rem;
		}
		.terminal-body pre {
			font-size: 0.45rem;
		}
		.terminal-command,
		.terminal-lines p {
			font-size: 0.78rem;
		}
	}
	@media (max-width: 420px) {
		.terminal-body pre {
			font-size: 0.38rem;
		}
	}
	.section-block {
		padding: 2.5rem 0;
		border-bottom: 1px solid rgb(var(--line));
	}
	.section-heading {
		margin-bottom: 1.25rem;
	}
	.section-heading h2 {
		margin: 0;
	}
	.note-list {
		display: grid;
		gap: 0.85rem;
	}
	.note-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1rem;
		padding: 1rem 0;
		border-top: 1px solid rgb(var(--line));
		color: inherit;
		text-decoration: none;
	}
	.note-row h3 {
		margin-bottom: 0.35rem;
	}
	.note-row p {
		margin-bottom: 0;
		color: rgb(var(--muted));
	}
	.note-row:hover h3 {
		color: var(--accent);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.4rem;
		max-width: 340px;
	}
	.tags span {
		display: inline-flex;
		align-items: center;
		height: 26px;
		padding: 0 0.55rem;
		background: rgb(var(--surface));
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		color: rgb(var(--muted));
		font-size: 0.78rem;
	}
	.topic-list {
		display: grid;
		border-top: 1px solid rgb(var(--line));
	}
	.topic-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.5rem;
		align-items: start;
		padding: 1rem 0;
		border-bottom: 1px solid rgb(var(--line));
		color: inherit;
		text-decoration: none;
	}
	.topic-row:hover h3 {
		color: var(--accent);
	}
	.topic-row h3 {
		margin: 0 0 0.25rem;
	}
	.topic-row p {
		max-width: 680px;
		margin: 0;
		color: rgb(var(--muted));
		font-size: 0.95rem;
	}
	.topic-row span {
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		white-space: nowrap;
	}
	.why-card {
		padding: 2.5rem 0 3rem;
	}
	.why-card h2 {
		max-width: none;
		margin: 0 0 1.25rem;
		font-size: clamp(1.35rem, 2.4vw, 1.9rem);
	}
	.why-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.why-grid div {
		padding: 1rem;
		background: rgb(var(--surface));
		border: 1px solid rgb(var(--line));
		border-radius: 8px;
	}
	.why-grid strong {
		display: block;
		margin-bottom: 0.35rem;
		color: rgb(var(--black));
	}
	.why-grid p {
		margin: 0;
		color: rgb(var(--muted));
		font-size: 0.94rem;
	}
	@media (max-width: 900px) {
		.why-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 720px) {
		.hero {
			padding-top: 2rem;
		}
		.note-row {
			grid-template-columns: 1fr;
		}
		.tags {
			justify-content: flex-start;
			max-width: none;
		}
		.topic-row {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
	}
</style>
