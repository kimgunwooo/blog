---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GlobalSidebar from '../components/GlobalSidebar.astro';
import Header from '../components/Header.astro';
import PostCards from '../components/PostCards.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main class="home-main">
				<section class="hero" aria-labelledby="home-title">
					<div class="home-intro">
						<div class="intro-copy">
							<p class="eyebrow">Platform / DevOps Notes</p>
							<h1 id="home-title">DevOps 여정기</h1>
							<p class="intro-lede">{SITE_DESCRIPTION}</p>
							<p class="intro-note">직접 막힌 지점을 기록하고, 작은 실험으로 다시 확인합니다.</p>
							<div class="intro-links" aria-label="주요 링크">
								<a href="/blog/">전체 글 보기</a>
								<a href="/about/">소개</a>
							</div>
						</div>
						<div class="terminal-hero" aria-label={`${SITE_TITLE} 작업 상태`}>
						<div class="terminal-top">
							<span></span>
							<span></span>
							<span></span>
							<strong>kimgunwooo ~/ops-log</strong>
						</div>
						<div class="terminal-body">
							<p class="terminal-command"><span class="prompt">$</span> notes status --scope platform</p>
							<div class="terminal-status">
								<p><span class="status-dot status-dot--green"></span><span class="status-label">watch</span> Docker · Kubernetes · Cloud</p>
								<p><span class="status-dot status-dot--blue"></span><span class="status-label">index</span> 실험과 운영 기준을 기록</p>
								<p><span class="status-dot status-dot--yellow"></span><span class="status-label">check</span> 가정은 다시 실행해 확인</p>
							</div>
							<p class="terminal-footer">last sync: now <span class="cursor" aria-hidden="true"></span></p>
						</div>
					</div>
					</div>
				</section>
				<section class="section-block" id="recent-notes" aria-labelledby="recent-notes-title">
					<div class="section-heading">
						<div>
							<p class="eyebrow">Technical Notes</p>
							<h2 id="recent-notes-title">최근 기록</h2>
						</div>
						<a class="section-link" href="/blog/">전체 글 보기</a>
					</div>
					<PostCards posts={posts} layout="home" maxTags={3} />
				</section>
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 2.5rem 0 1.35rem;
	}
	.home-main {
		width: min(100%, 1180px) !important;
		max-width: 1180px !important;
		justify-self: center;
	}
	.home-intro {
		display: grid;
		grid-template-columns: minmax(0, 0.98fr) minmax(360px, 1.02fr);
		align-items: center;
		gap: 3rem;
		padding: 0 0 2.65rem;
		border-bottom: 1px solid rgb(var(--line));
	}
	.intro-copy {
		max-width: 30rem;
	}
	.intro-copy h1 {
		margin-bottom: 0.7rem;
		font-size: clamp(2.15rem, 3.6vw, 3.15rem);
	}
	.intro-lede {
		margin: 0;
		color: rgb(var(--muted));
		font-size: clamp(0.96rem, 1.35vw, 1.08rem);
		line-height: 1.7;
	}
	.intro-note {
		margin: 1rem 0 0;
		color: rgb(var(--gray-dark));
		font-size: 0.92rem;
		line-height: 1.65;
	}
	.intro-links {
		display: flex;
		gap: 1rem;
		margin-top: 1.4rem;
	}
	.intro-links a {
		color: var(--accent);
		font-size: 0.88rem;
		font-weight: 800;
		text-decoration: none;
	}
	.intro-links a::after {
		content: ' →';
	}
	.intro-links a:hover {
		text-decoration: underline;
	}
	.eyebrow,
	.label {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		letter-spacing: 0;
		text-transform: uppercase;
	}
	.terminal-hero {
		position: relative;
		overflow: hidden;
		width: 100%;
		max-width: 35rem;
		justify-self: end;
		background: #090d1a;
		border: 1px solid rgba(15, 23, 42, 0.18);
		border-radius: 13px;
		box-shadow: 0 18px 44px rgba(15, 23, 42, 0.14);
	}
	.terminal-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(rgba(255, 255, 255, 0.025) 50%, transparent 50%);
		background-size: 100% 4px;
		opacity: 0.35;
		pointer-events: none;
	}
	.terminal-top {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.85rem 1rem;
		background: #0f1526;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.terminal-top span {
		width: 11px;
		height: 11px;
		border-radius: 999px;
	}
	.terminal-top span:nth-child(1) {
		background: #ff5f57;
	}
	.terminal-top span:nth-child(2) {
		background: #ffbd2e;
	}
	.terminal-top span:nth-child(3) {
		background: #28c840;
	}
	.terminal-top strong {
		margin-left: 0.35rem;
		color: #9aa8bd;
		font-size: 0.76rem;
		font-weight: 800;
	}
	.terminal-body {
		position: relative;
		z-index: 1;
		padding: 1.15rem 1.25rem 1.1rem;
		color: #d8e2ee;
		font-family:
			'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
	}
	.terminal-command {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0 0 0.9rem;
		color: #7dd3fc;
		font-size: 0.8rem;
		white-space: nowrap;
	}
	.terminal-status {
		display: grid;
		gap: 0.42rem;
		padding: 0.8rem 0;
		border-top: 1px solid rgba(216, 226, 238, 0.72);
		border-bottom: 1px dashed rgba(216, 226, 238, 0.26);
	}
	.terminal-status p {
		margin: 0;
		color: #aebdd1;
		font-size: 0.76rem;
		line-height: 1.55;
	}
	.status-label {
		display: inline-block;
		min-width: 4.3rem;
		color: #8393aa;
		font-size: 0.74rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.status-dot {
		display: inline-block;
		width: 0.48rem;
		height: 0.48rem;
		margin-right: 0.45rem;
		border-radius: 50%;
		vertical-align: 0.05em;
	}
	.status-dot--green {
		background: #22c55e;
	}
	.status-dot--blue {
		background: #7dd3fc;
	}
	.status-dot--yellow {
		background: #facc15;
	}
	.terminal-footer {
		margin: 0;
		color: #8393aa;
		font-size: 0.75rem;
	}
	.prompt {
		color: #22c55e;
		font-weight: 800;
		margin-right: 0.2rem;
	}
	.cursor {
		display: inline-block;
		width: 8px;
		height: 1.1em;
		margin-left: 0.25rem;
		background: #22c55e;
		vertical-align: -0.2em;
		animation: cursor-blink 1s steps(2, start) infinite;
	}
	@keyframes cursor-blink {
		50% {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
	@media (max-width: 720px) {
		.home-main {
			width: 100% !important;
		}
		.home-intro {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
		.terminal-body {
			padding: 1rem;
		}
		.terminal-command,
		.terminal-status p {
			font-size: 0.78rem;
		}
	}
	.section-block {
		padding: 2.5rem 0;
		border-bottom: 1px solid rgb(var(--line));
	}
	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}
	.section-heading h2 {
		margin: 0;
	}
	.section-link {
		color: var(--accent);
		font-size: 0.86rem;
		font-weight: 800;
		text-decoration: none;
	}
	.section-link:hover {
		text-decoration: underline;
	}
	@media (max-width: 720px) {
		.hero {
			padding-top: 2rem;
		}
		.section-heading {
			align-items: start;
			flex-direction: column;
		}
	}
</style>
