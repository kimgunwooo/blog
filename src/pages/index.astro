---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GlobalSidebar from '../components/GlobalSidebar.astro';
import Header from '../components/Header.astro';
import PostCards from '../components/PostCards.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main class="home-main">
				<section class="hero" aria-labelledby="home-title">
					<p class="eyebrow">Platform Engineer · DevOps</p>
					<h1 id="home-title">운영 문제를 계측하고 재현해,<br />다시 사용할 수 있는 기준으로 남깁니다.</h1>
					<p class="hero-description">
						직접 겪은 장애와 궁금증을 실험하고, 결과뿐 아니라 판단 과정과 한계까지 기록합니다.
					</p>
					<p class="hero-note">관측한 문제를 재현하고, 검증한 결과를 기준으로 남깁니다.</p>
				</section>
				<section class="section-block" id="recent-notes" aria-labelledby="recent-notes-title">
					<div class="section-heading">
						<p class="eyebrow">Technical Notes</p>
						<h2 id="recent-notes-title">최근 기록</h2>
					</div>
					<PostCards posts={posts} layout="home" maxTags={0} />
				</section>
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	.site-layout > .home-main {
		width: min(100%, 1040px);
		max-width: 1040px;
	}
	.hero {
		max-width: 780px;
		padding: 4.5rem 0 3.5rem;
	}
	.hero h1 {
		margin: 0;
		font-size: 3.15rem;
		line-height: 1.25;
	}
	.hero-description {
		max-width: 680px;
		margin: 1.5rem 0 0;
		color: rgb(var(--muted));
		font-size: 1.08rem;
		line-height: 1.75;
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 800;
		letter-spacing: 0;
	}
	.hero-note {
		margin: 1.35rem 0 0;
		color: var(--accent);
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.6;
	}
	.section-block {
		padding: 2.5rem 0 0;
		border-top: 1px solid rgb(var(--line));
		scroll-margin-top: 5rem;
	}
	.section-heading {
		display: block;
		margin-bottom: 1.25rem;
	}
	.section-heading h2 {
		margin: 0;
	}
	@media (max-width: 720px) {
		.site-layout > .home-main {
			width: 100%;
			max-width: none;
		}
		.hero {
			padding: 3rem 0 2.75rem;
		}
		.hero h1 {
			font-size: 2.25rem;
		}
		.hero-description {
			font-size: 1rem;
		}
	}
</style>
