---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import GlobalSidebar from '../../components/GlobalSidebar.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title="Notes | DevOps Journey" description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main>
				<section class="page-title">
					<p class="eyebrow">Notes</p>
					<h1>기술 노트</h1>
					<p>개념 정리, 작은 실험, 트러블슈팅을 섞어서 씁니다.</p>
				</section>
				<section class="posts">
					{
						posts.map((post) => (
							<a class="post-row" href={`/blog/${post.id}/`}>
								<div class="post-main">
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
										<span>{post.data.category}</span>
									</p>
									<h2>{post.data.title}</h2>
									<p>{post.data.description}</p>
								</div>
								<div class="tags">
									{post.data.tags.map((tag) => (
										<span>{tag}</span>
									))}
								</div>
							</a>
						))
					}
				</section>
			</main>
		</div>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		padding: 2rem 0 1.75rem;
		border-bottom: 1px solid rgb(var(--line));
	}
	.eyebrow,
	.date {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.date {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.date span {
		color: rgb(var(--muted));
	}
	.page-title p:last-child {
		color: rgb(var(--muted));
	}
	.posts {
		display: grid;
		border-top: 1px solid rgb(var(--line));
		margin-top: 2.25rem;
	}
	.post-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(180px, 260px);
		gap: 1.5rem;
		align-items: start;
		padding: 1.25rem 0;
		border-bottom: 1px solid rgb(var(--line));
		color: inherit;
		text-decoration: none;
	}
	.post-row h2 {
		margin-bottom: 0.4rem;
		font-size: 1.35rem;
	}
	.post-main > p:last-child {
		margin: 0;
		color: rgb(var(--muted));
	}
	.post-row:hover h2 {
		color: var(--accent);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.4rem;
	}
	.tags span {
		padding: 0.25rem 0.5rem;
		background: rgb(var(--surface));
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		color: rgb(var(--muted));
		font-size: 0.78rem;
	}
	@media (max-width: 760px) {
		.post-row {
			grid-template-columns: 1fr;
			gap: 0.8rem;
		}
		.tags {
			justify-content: flex-start;
		}
	}
</style>
