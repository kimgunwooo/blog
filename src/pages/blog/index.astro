---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import GlobalSidebar from '../../components/GlobalSidebar.astro';
import Header from '../../components/Header.astro';
import PostCards from '../../components/PostCards.astro';
import { BLOG_CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const counts = new Map<string, number>();
for (const post of posts) {
	counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Notes | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main>
				<section class="page-title">
					<p class="eyebrow">Notes</p>
					<h1>기술 노트</h1>
					<p>
						개념을 외우기보다 직접 막힌 지점, 작은 실험, 운영 중 확인한 기준을 순서대로 남깁니다.
					</p>
				</section>
				<section class="notes-tools" data-notes-tools aria-label="글 검색과 토픽 필터">
					<div class="search-box">
						<label for="notes-search">Search</label>
						<input
							id="notes-search"
							type="search"
							placeholder="Docker, BuildKit, GitOps..."
							autocomplete="off"
							data-search-input
						/>
					</div>
					<div class="filter-row" aria-label="토픽 필터">
						<button
							class="filter-chip active"
							type="button"
							data-category-filter="all"
							aria-pressed="true"
						>
							전체 <span>{posts.length}</span>
						</button>
						{
							BLOG_CATEGORIES.map((category) => (
								<button
									class="filter-chip"
									type="button"
									data-category-filter={category.label}
									aria-pressed="false"
								>
									{category.label} <span>{counts.get(category.label) ?? 0}</span>
								</button>
							))
						}
					</div>
					<p class="result-status" data-result-status>{posts.length}개의 글</p>
				</section>
				<PostCards posts={posts} />
				<p class="no-results" data-no-results hidden>
					조건에 맞는 글이 아직 없습니다. 검색어를 줄이거나 다른 토픽을 선택해보세요.
				</p>
				<nav class="pagination" data-pagination aria-label="글 목록 페이지"></nav>
			</main>
		</div>
		<Footer />
	</body>
</html>

<script is:inline>
	const tools = document.querySelector('[data-notes-tools]');

	if (tools) {
		const searchInput = tools.querySelector('[data-search-input]');
		const filterButtons = [...tools.querySelectorAll('[data-category-filter]')];
		const resultStatus = tools.querySelector('[data-result-status]');
		const postItems = [...document.querySelectorAll('[data-post-item]')];
		const noResults = document.querySelector('[data-no-results]');
		const pagination = document.querySelector('[data-pagination]');
		const perPage = 9;
		let activeCategory = 'all';
		let currentPage = Math.max(1, Number(new URLSearchParams(location.search).get('page')) || 1);
		let pagefindPromise;
		let searchVersion = 0;

		const normalize = (value) => value.toLowerCase().replace(/\s+/g, ' ').trim();

		const normalizePath = (value) => {
			try {
				return new URL(value, location.origin).pathname.replace(/\/$/, '');
			} catch {
				return value.replace(/\/$/, '');
			}
		};

		const loadPagefind = async () => {
			if (!pagefindPromise) {
				pagefindPromise = import(/* @vite-ignore */ '/pagefind/pagefind.js').catch(() => null);
			}
			return pagefindPromise;
		};

		const getMetadataMatches = (query) => {
			const matches = new Set();
			for (const item of postItems) {
				const searchable = normalize(
					[
						item.dataset.title,
						item.dataset.description,
						item.dataset.category,
						item.dataset.tags,
					].join(' '),
				);
				if (query.length === 0 || searchable.includes(query)) {
					matches.add(normalizePath(item.getAttribute('href') ?? ''));
				}
			}
			return matches;
		};

		const getPagefindMatches = async (query) => {
			if (query.length === 0) return null;

			const pagefind = await loadPagefind();
			if (!pagefind?.search) return null;

			const search = await pagefind.search(query);
			const urls = await Promise.all(
				search.results.map(async (result) => {
					const data = await result.data();
					return normalizePath(data.url);
				}),
			);
			return new Set(urls);
		};

		const updatePageUrl = () => {
			const url = new URL(location.href);
			if (currentPage === 1) url.searchParams.delete('page');
			else url.searchParams.set('page', String(currentPage));
			history.replaceState(null, '', url);
		};

		const renderPagination = (pageCount) => {
			if (!pagination) return;
			pagination.replaceChildren();
			pagination.hidden = pageCount <= 1;
			if (pageCount <= 1) return;

			const createButton = (label, page, { disabled = false, type = 'page' } = {}) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.textContent = label;
				button.dataset.page = String(page);
				button.disabled = disabled;
				button.className = `pagination-button pagination-button--${type}`;
				if (type !== 'page') button.setAttribute('aria-label', label === '←' ? '이전 페이지' : '다음 페이지');
				return button;
			};

			pagination.append(createButton('←', currentPage - 1, { disabled: currentPage === 1, type: 'previous' }));
			for (let page = 1; page <= pageCount; page += 1) {
				const button = createButton(String(page), page);
				button.classList.toggle('active', page === currentPage);
				button.setAttribute('aria-current', page === currentPage ? 'page' : 'false');
				pagination.append(button);
			}
			pagination.append(createButton('→', currentPage + 1, { disabled: currentPage === pageCount, type: 'next' }));
		};

		const updatePosts = async ({ resetPage = false, scroll = false } = {}) => {
			const currentVersion = ++searchVersion;
			const query = normalize(searchInput?.value ?? '');
			const pagefindMatches = await getPagefindMatches(query);
			if (currentVersion !== searchVersion) return;

			const matchedUrls = pagefindMatches ?? getMetadataMatches(query);
			const matchingItems = postItems.filter((item) => {
				const category = item.dataset.category ?? '';
				const path = normalizePath(item.getAttribute('href') ?? '');
				return (activeCategory === 'all' || category === activeCategory) && matchedUrls.has(path);
			});
			const pageCount = Math.max(1, Math.ceil(matchingItems.length / perPage));
			if (resetPage) currentPage = 1;
			currentPage = Math.min(currentPage, pageCount);
			const start = (currentPage - 1) * perPage;
			const visibleItems = new Set(matchingItems.slice(start, start + perPage));

			for (const item of postItems) {
				item.hidden = !visibleItems.has(item);
			}

			if (resultStatus) {
				const categoryText = activeCategory === 'all' ? '전체' : activeCategory;
				resultStatus.textContent = matchingItems.length
					? `${categoryText} · ${matchingItems.length}개의 글 · ${currentPage} / ${pageCount} 페이지`
					: `${categoryText} · 0개의 글`;
			}
			if (noResults) {
				noResults.hidden = matchingItems.length !== 0;
			}
			renderPagination(pageCount);
			updatePageUrl();
			if (scroll) {
				resultStatus?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};

		for (const button of filterButtons) {
			button.addEventListener('click', () => {
				activeCategory = button.dataset.categoryFilter ?? 'all';
				for (const target of filterButtons) {
					target.classList.toggle('active', target === button);
					target.setAttribute('aria-pressed', target === button ? 'true' : 'false');
				}
				void updatePosts({ resetPage: true });
			});
		}

		searchInput?.addEventListener('input', () => {
			void updatePosts({ resetPage: true });
		});
		pagination?.addEventListener('click', (event) => {
			const button = event.target.closest('button[data-page]');
			if (!(button instanceof HTMLButtonElement) || button.disabled) return;
			currentPage = Number(button.dataset.page) || 1;
			void updatePosts({ scroll: true });
		});
		void updatePosts();
	}
</script>

<style>
	.page-title {
		padding: 2rem 0 1.5rem;
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.page-title p:last-child {
		max-width: 680px;
		color: rgb(var(--muted));
	}
	.notes-tools {
		display: grid;
		gap: 1rem;
		padding: 1.25rem 0 1.35rem;
	}
	.search-box {
		display: grid;
		grid-template-columns: 84px minmax(0, 1fr);
		align-items: center;
		gap: 1rem;
		padding-bottom: 1rem;
	}
	.search-box label {
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 800;
		text-transform: uppercase;
	}
	.search-box input {
		width: 100%;
		padding: 0.75rem 0;
		color: rgb(var(--black));
		background: transparent;
		border: 0;
		border-bottom: 1px solid rgba(var(--gray), 0.35);
		border-radius: 0;
		font: inherit;
		outline: none;
	}
	.search-box input:focus {
		border-color: var(--accent);
	}
	.filter-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}
	.filter-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		min-height: 34px;
		padding: 0.35rem 0.72rem;
		color: rgb(var(--muted));
		background: #fff;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		font: inherit;
		font-size: 0.86rem;
		font-weight: 750;
		cursor: pointer;
	}
	.filter-chip span {
		color: rgba(var(--gray), 0.8);
		font-size: 0.78rem;
	}
	.filter-chip:hover,
	.filter-chip.active {
		color: #fff;
		background: var(--accent);
		border-color: var(--accent);
	}
	.filter-chip:hover span,
	.filter-chip.active span {
		color: rgba(255, 255, 255, 0.78);
	}
	.result-status {
		margin: 0;
		color: rgb(var(--muted));
		font-size: 0.86rem;
		font-weight: 800;
		scroll-margin-top: 5.5rem;
	}
	.no-results {
		margin: 0;
		padding: 2rem 0;
		color: rgb(var(--muted));
		border-top: 1px solid rgb(var(--line));
		border-bottom: 1px solid rgb(var(--line));
	}
	.pagination {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: center;
		justify-content: center;
		margin-top: 2.75rem;
		padding: 1.25rem 0 0.5rem;
		border-top: 1px solid rgb(var(--line));
	}
	.pagination :global(.pagination-button) {
		display: grid;
		width: 2.2rem;
		height: 2.2rem;
		place-items: center;
		padding: 0;
		color: rgb(var(--muted));
		background: #fff;
		border: 1px solid rgb(var(--line));
		border-radius: 3px;
		font: inherit;
		font-size: 0.84rem;
		font-weight: 800;
		cursor: pointer;
		transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
	}
	.pagination :global(.pagination-button--previous),
	.pagination :global(.pagination-button--next) {
		font-size: 1rem;
	}
	.pagination :global(.pagination-button:hover:not(:disabled)),
	.pagination :global(.pagination-button.active) {
		color: #fff;
		background: var(--accent);
		border-color: var(--accent);
	}
	.pagination :global(.pagination-button:disabled) {
		cursor: default;
		opacity: 0.38;
	}
	@media (max-width: 720px) {
		.result-status {
			scroll-margin-top: 7.25rem;
		}
		.search-box {
			grid-template-columns: 1fr;
			gap: 0.35rem;
		}
	}
</style>
