---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import GlobalSidebar from '../../components/GlobalSidebar.astro';
import Header from '../../components/Header.astro';
import PostCards from '../../components/PostCards.astro';
import { BLOG_CATEGORIES, CORE_TAGS, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tagSet = new Set<string>();
for (const post of posts) {
	for (const tag of post.data.tags) {
		tagSet.add(tag);
	}
}
const tags = CORE_TAGS.filter((tag) => tagSet.has(tag));
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Notes | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout notes-page-layout" data-notes-tools aria-label="글 목록과 토픽 필터">
			<GlobalSidebar />
			<main class="notes-main">
				<nav class="category-nav" aria-label="글 카테고리">
					<button
						class="category-tab active"
						type="button"
						data-category-filter="all"
						data-umami-event="category-filter"
						data-umami-event-category="all"
						aria-pressed="true"
					>
						전체
					</button>
					{
						BLOG_CATEGORIES.map((category) => (
							<button
								class="category-tab"
								type="button"
								data-category-filter={category.label}
								data-umami-event="category-filter"
								data-umami-event-category={category.label}
								aria-pressed="false"
							>
								{category.label}
							</button>
						))
					}
				</nav>
				<section class="notes-summary" aria-label="글 목록 요약">
					<p class="result-status" data-result-status>{posts.length}개의 글</p>
				</section>
				<PostCards posts={posts} layout="home" />
				<p class="no-results" data-no-results hidden>
					조건에 맞는 글이 아직 없습니다. 다른 토픽을 선택해보세요.
				</p>
				<nav class="pagination" data-pagination aria-label="글 목록 페이지"></nav>
			</main>
			<aside class="notes-filter-panel" aria-label="토픽 필터">
				<p class="eyebrow">Tags</p>
				<h2>태그</h2>
				<div class="tag-cloud">
					{
						tags.map((tag) => (
							<button
								class="tag-chip"
								type="button"
								data-tag-filter={tag}
								data-umami-event="tag-filter"
								data-umami-event-tag={tag}
								aria-pressed="false"
							>
								{tag}
							</button>
						))
					}
				</div>
			</aside>
		</div>
		<Footer />
	</body>
</html>

<script is:inline>
	const tools = document.querySelector('[data-notes-tools]');

	if (tools) {
		const categoryButtons = [...tools.querySelectorAll('[data-category-filter]')];
		const tagButtons = [...tools.querySelectorAll('[data-tag-filter]')];
		const resultStatus = tools.querySelector('[data-result-status]');
		const postItems = [...document.querySelectorAll('[data-post-item]')];
		const noResults = document.querySelector('[data-no-results]');
		const pagination = document.querySelector('[data-pagination]');
		const perPage = 8;
		let activeCategory = 'all';
		let activeTag = 'all';
		let currentPage = Math.max(1, Number(new URLSearchParams(location.search).get('page')) || 1);
		const updatePageUrl = () => {
			const url = new URL(location.href);
			if (currentPage === 1) url.searchParams.delete('page');
			else url.searchParams.set('page', String(currentPage));
			history.replaceState(null, '', url);
		};

		const renderPagination = (pageCount) => {
			if (!pagination) return;
			pagination.replaceChildren();
			pagination.hidden = pageCount <= 1;
			if (pageCount <= 1) return;

			const createButton = (label, page, { disabled = false, type = 'page' } = {}) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.textContent = label;
				button.dataset.page = String(page);
				button.disabled = disabled;
				button.className = `pagination-button pagination-button--${type}`;
				if (type !== 'page') button.setAttribute('aria-label', label === '←' ? '이전 페이지' : '다음 페이지');
				return button;
			};

			pagination.append(createButton('←', currentPage - 1, { disabled: currentPage === 1, type: 'previous' }));
			for (let page = 1; page <= pageCount; page += 1) {
				const button = createButton(String(page), page);
				button.classList.toggle('active', page === currentPage);
				button.setAttribute('aria-current', page === currentPage ? 'page' : 'false');
				pagination.append(button);
			}
			pagination.append(createButton('→', currentPage + 1, { disabled: currentPage === pageCount, type: 'next' }));
		};

		const updatePosts = ({ resetPage = false, scroll = false } = {}) => {
			const matchingItems = postItems.filter((item) => {
				const category = item.dataset.category ?? '';
				const tags = (item.dataset.tags ?? '').split(/\s+/).filter(Boolean);
				return (
					(activeCategory === 'all' || category === activeCategory) &&
					(activeTag === 'all' || tags.includes(activeTag))
				);
			});
			const pageCount = Math.max(1, Math.ceil(matchingItems.length / perPage));
			if (resetPage) currentPage = 1;
			currentPage = Math.min(currentPage, pageCount);
			const start = (currentPage - 1) * perPage;
			const visibleItems = new Set(matchingItems.slice(start, start + perPage));

			for (const item of postItems) {
				item.hidden = !visibleItems.has(item);
			}

			if (resultStatus) {
				const categoryText = activeCategory === 'all' ? '전체' : activeCategory;
				const tagText = activeTag === 'all' ? '' : ` · ${activeTag}`;
				resultStatus.textContent = matchingItems.length
					? `${categoryText}${tagText} · ${matchingItems.length}개의 글 · ${currentPage} / ${pageCount} 페이지`
					: `${categoryText}${tagText} · 0개의 글`;
			}
			if (noResults) {
				noResults.hidden = matchingItems.length !== 0;
			}
			renderPagination(pageCount);
			updatePageUrl();
			if (scroll) {
				resultStatus?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		};

		for (const button of categoryButtons) {
			button.addEventListener('click', () => {
				activeCategory = button.dataset.categoryFilter ?? 'all';
				for (const target of categoryButtons) {
					target.classList.toggle('active', target === button);
					target.setAttribute('aria-pressed', target === button ? 'true' : 'false');
				}
				updatePosts({ resetPage: true });
			});
		}
		for (const button of tagButtons) {
			button.addEventListener('click', () => {
				activeTag = activeTag === button.dataset.tagFilter ? 'all' : button.dataset.tagFilter ?? 'all';
				for (const target of tagButtons) {
					target.classList.toggle('active', target === button && activeTag !== 'all');
					target.setAttribute('aria-pressed', target === button && activeTag !== 'all' ? 'true' : 'false');
				}
				updatePosts({ resetPage: true });
			});
		}

		pagination?.addEventListener('click', (event) => {
			const button = event.target.closest('button[data-page]');
			if (!(button instanceof HTMLButtonElement) || button.disabled) return;
			currentPage = Number(button.dataset.page) || 1;
			updatePosts({ scroll: true });
		});
		updatePosts();
	}
</script>

<style>
	.notes-summary {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		min-height: 3.25rem;
		padding-top: 0.2rem;
	}
	.category-nav {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.65rem;
		overflow-x: auto;
		padding: 0.25rem 0 1rem;
		border-bottom: 1px solid rgb(var(--line));
		scrollbar-width: none;
	}
	.category-nav::-webkit-scrollbar {
		display: none;
	}
	.category-tab {
		position: relative;
		flex: 0 0 auto;
		padding: 0.35rem 0;
		color: rgba(var(--gray), 0.7);
		background: transparent;
		border: 0;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 750;
		white-space: nowrap;
		cursor: pointer;
	}
	.category-tab::after {
		position: absolute;
		right: 0;
		bottom: -1rem;
		left: 0;
		height: 2px;
		background: transparent;
		content: '';
	}
	.category-tab:hover,
	.category-tab.active {
		color: rgb(var(--black));
	}
	.category-tab.active::after {
		background: var(--accent);
	}
	.notes-page-layout {
		grid-template-columns: 220px minmax(0, 1fr) 220px;
		column-gap: 1.25rem;
	}
	.notes-main {
		padding-inline: clamp(2rem, 4vw, 5rem);
	}
	.notes-filter-panel {
		position: sticky;
		top: 112px;
		align-self: start;
		max-height: calc(100dvh - 112px);
		overflow-y: auto;
		padding: 0.5rem 0 0.5rem;
		scrollbar-width: none;
	}
	.notes-filter-panel::-webkit-scrollbar {
		display: none;
	}
	.notes-filter-panel h2 {
		margin-bottom: 1rem;
		font-size: 1.2rem;
	}
	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.6rem 0.45rem;
	}
	.tag-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 38px;
		padding: 0.42rem 0.78rem;
		color: rgb(var(--muted));
		background: rgba(var(--gray-light), 0.6);
		border: 0;
		border-radius: 999px;
		font: inherit;
		font-size: 0.84rem;
		font-weight: 750;
		line-height: 1.25;
		cursor: pointer;
	}
	.tag-chip:hover,
	.tag-chip.active {
		color: #fff;
		background: var(--accent);
	}
	.result-status {
		margin: 0;
		color: rgb(var(--muted));
		font-size: 0.76rem;
		font-weight: 800;
		line-height: 1.4;
		white-space: nowrap;
		scroll-margin-top: 5.5rem;
	}
	.no-results {
		margin: 0;
		padding: 2rem 0;
		color: rgb(var(--muted));
		border-top: 1px solid rgb(var(--line));
		border-bottom: 1px solid rgb(var(--line));
	}
	.pagination {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		align-items: center;
		justify-content: center;
		margin-top: 2.75rem;
		padding: 1.25rem 0 0.5rem;
		border-top: 1px solid rgb(var(--line));
	}
	.pagination :global(.pagination-button) {
		display: grid;
		width: 2.2rem;
		height: 2.2rem;
		place-items: center;
		padding: 0;
		color: rgb(var(--muted));
		background: rgb(var(--surface-strong));
		border: 1px solid rgb(var(--line));
		border-radius: 3px;
		font: inherit;
		font-size: 0.84rem;
		font-weight: 800;
		cursor: pointer;
		transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
	}
	.pagination :global(.pagination-button--previous),
	.pagination :global(.pagination-button--next) {
		font-size: 1rem;
	}
	.pagination :global(.pagination-button:hover:not(:disabled)),
	.pagination :global(.pagination-button.active) {
		color: #fff;
		background: var(--accent);
		border-color: var(--accent);
	}
	.pagination :global(.pagination-button:disabled) {
		cursor: default;
		opacity: 0.38;
	}
	@media (max-width: 900px) {
		.notes-page-layout {
			grid-template-columns: 1fr;
		}
		.notes-main {
			padding-inline: 0;
		}
		.notes-filter-panel {
			position: static;
			padding: 1.25rem 0 0;
			border-top: 1px solid rgb(var(--line));
			border-left: 0;
		}
	}
	@media (max-width: 720px) {
		.result-status {
			scroll-margin-top: 7.25rem;
		}
	}
	@media (min-width: 901px) and (max-width: 1100px) {
		.notes-page-layout {
			grid-template-columns: 180px minmax(0, 1fr);
		}
		.notes-filter-panel {
			grid-column: 2;
			position: static;
			padding: 1.25rem 0 0;
			border-top: 1px solid rgb(var(--line));
			border-left: 0;
		}
	}
</style>
