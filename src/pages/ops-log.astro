---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GlobalSidebar from '../components/GlobalSidebar.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const changelog = [
	{
		version: 'v0.6',
		date: '2026.07.29',
		title: '글 목록 탐색 흐름 정리',
		items: [
			'글에 포함된 이미지를 목록 썸네일로 사용하고, 최근 기록의 첫 글을 크게 노출',
			'전체 글에 검색·토픽 필터와 9개 단위 페이지네이션 추가',
			'페이지 전환 시 현재 페이지 정보와 새 목록 첫 행으로 이동하도록 모바일 읽기 흐름 보완',
		],
	},
	{
		version: 'v0.5',
		date: '2026.07.29',
		title: '글 읽기와 다이어그램 확인 흐름 개선',
		items: [
			'본문 읽기 진행률과 현재 목차 위치를 확인할 수 있도록 읽기 인터랙션 추가',
			'코드 블록 복사 버튼과 본문 이미지 확대 보기 추가',
			'Mermaid 다이어그램을 글 폭에 맞춰 표시하고, 확대·이동·맞춤 보기 지원',
		],
	},
	{
		version: 'v0.4',
		date: '2026.07.22',
		title: '본문 검색 기능 추가',
		items: [
			'Pagefind를 붙여 Notes에서 글 본문까지 검색 가능하도록 변경',
			'검색어와 Topic 필터를 함께 적용하도록 글 목록 동작 수정',
			'빌드 시 검색 인덱스가 생성되도록 npm build 흐름에 Pagefind 추가',
		],
	},
	{
		version: 'v0.3',
		date: '2026.07.22',
		title: 'Notes와 Topics 구조 정리',
		items: [
			'상단 Categories 메뉴와 별도 허브 페이지 제거',
			'사이드바 Topics는 빠른 주제 이동으로 유지',
			'Topic 상세에서는 전체 글 목록으로 돌아가도록 링크 정리',
		],
	},
	{
		version: 'v0.2',
		date: '2026.07',
		title: '홈 Kubernetes 배포 연결',
		items: [
			'GHCR image와 Argo CD 기반 배포 흐름 구성',
			'Cloudflare Tunnel을 통해 공개 URL 연결',
			'ImagePullBackOff 발생 후 multi-platform build 기준 점검',
		],
	},
	{
		version: 'v0.1',
		date: '2026.07',
		title: '정적 기술 블로그 시작',
		items: [
			'Astro 기반 Markdown 블로그 구성',
			'Docker, Kubernetes, Observability, Automation 토픽 분리',
			'Velog는 정리된 공개 글, 이 사이트는 실험 노트 중심으로 역할 분리',
		],
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`운영 기록 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div class="site-layout">
			<GlobalSidebar />
			<main>
				<section class="page-title">
					<p class="eyebrow">Blog Operations</p>
					<h1>블로그 운영 기록</h1>
					<p>
						검색, 읽기 흐름, 배포 방식처럼 이 블로그 자체를 다듬은 과정을 날짜별로 남깁니다.
						장애 원인 분석이나 트러블슈팅은 별도 기술 노트로 분리합니다.
					</p>
				</section>
				<section class="timeline" aria-label="블로그 운영 기록">
					{
						changelog.map((item) => (
							<article class="timeline-item">
								<div class="timeline-date">{item.date}</div>
								<div class="timeline-marker" aria-hidden="true"></div>
								<div class="timeline-copy">
									<p class="status">{item.version}</p>
									<h2>{item.title}</h2>
									<ul>
										{item.items.map((entry) => (
											<li>{entry}</li>
										))}
									</ul>
								</div>
							</article>
						))
					}
				</section>
			</main>
		</div>
		<Footer />
	</body>
</html>

<style is:inline>
	.page-title {
		padding: 2rem 0 1.5rem;
		border-bottom: 1px solid rgb(var(--line));
	}
	.eyebrow,
	.status {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
	}
	.page-title p:last-child {
		max-width: 760px;
		color: rgb(var(--muted));
	}
	.timeline {
		display: grid;
		position: relative;
		padding: 2rem 0 0;
	}
	.timeline::before {
		content: '';
		position: absolute;
		top: 2.45rem;
		bottom: 0.4rem;
		left: 108px;
		width: 1px;
		background: rgb(var(--line));
	}
	.timeline-item {
		display: grid;
		grid-template-columns: 88px 40px minmax(0, 1fr);
		gap: 0.8rem;
		position: relative;
		padding: 0 0 1.7rem;
	}
	.timeline-date {
		padding-top: 0.2rem;
		color: rgb(var(--muted));
		font-size: 0.82rem;
		font-weight: 700;
	}
	.timeline-marker {
		position: relative;
		z-index: 1;
		width: 13px;
		height: 13px;
		margin-top: 0.38rem;
		border: 2px solid var(--accent);
		border-radius: 999px;
		background: #fff;
		box-shadow: 0 0 0 5px #fff;
	}
	.timeline-copy {
		min-width: 0;
		padding: 0 0 1.45rem;
		border-bottom: 1px solid rgb(var(--line));
	}
	.timeline-item:last-child {
		padding-bottom: 0;
	}
	.timeline-item:last-child .timeline-copy {
		border-bottom: 0;
	}
	h2 {
		margin: 0 0 0.7rem;
		font-size: 1.3rem;
		word-break: keep-all;
		overflow-wrap: normal;
	}
	ul {
		display: grid;
		gap: 0.45rem;
		margin: 0;
		padding-left: 1.1rem;
		color: rgb(var(--muted));
		word-break: keep-all;
		overflow-wrap: normal;
	}
	@media (max-width: 720px) {
		.timeline::before {
			left: 6px;
		}
		.timeline-item {
			grid-template-columns: 20px minmax(0, 1fr);
			gap: 0.75rem;
		}
		.timeline-date {
			grid-column: 2;
			padding-top: 0;
		}
		.timeline-marker {
			grid-column: 1;
			grid-row: 1 / span 2;
		}
		.timeline-copy {
			grid-column: 2;
		}
	}
</style>
