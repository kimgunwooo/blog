---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	showCategory?: boolean;
	showTime?: boolean;
	showSeconds?: boolean;
	maxTags?: number;
	compact?: boolean;
	emptyTitle?: string;
	emptyDescription?: string;
}

const {
	posts,
	showCategory = true,
	showTime,
	showSeconds = true,
	maxTags = Number.POSITIVE_INFINITY,
	compact = false,
	emptyTitle = '아직 작성 중입니다',
	emptyDescription = '이 주제는 공부하면서 글을 채워갈 예정입니다.',
} = Astro.props;
---

{
	posts.length === 0 ? (
		<section class="empty-state">
			<p class="empty-label">No notes yet</p>
			<h2>{emptyTitle}</h2>
			<p>{emptyDescription}</p>
		</section>
	) : (
		<section class:list={['post-list', { compact }]} aria-label="글 목록">
			{posts.map((post) => {
				const visibleTags = post.data.tags.slice(0, maxTags);
				const hiddenTagCount = post.data.tags.length - visibleTags.length;

				return (
					<a
						class="post-item"
						href={`/blog/${post.id}/`}
						data-post-item
						data-umami-event="post-click"
						data-umami-event-post={post.id}
						data-title={post.data.title}
						data-description={post.data.description}
						data-category={post.data.category}
						data-tags={post.data.tags.join(' ')}
					>
						<div class="post-meta">
							<FormattedDate
								date={post.data.pubDate}
								relativeDate={post.data.createdAt}
								showTime={showTime ?? post.data.showTime}
								showSeconds={showSeconds}
							/>
							{showCategory && <span class="category-badge">{post.data.category}</span>}
						</div>
						<div class="post-body">
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
							{visibleTags.length > 0 && (
								<div class="post-tags">
									{visibleTags.map((tag) => (
										<span>{tag}</span>
									))}
									{hiddenTagCount > 0 && <span>+{hiddenTagCount}</span>}
								</div>
							)}
						</div>
					</a>
				);
			})}
		</section>
	)
}

<style>
	.post-list {
		display: grid;
		border-top: 1px solid rgb(var(--line));
	}
	.post-item {
		display: grid;
		grid-template-columns: 148px minmax(0, 1fr);
		gap: 1.4rem;
		align-items: start;
		padding: 1.45rem 0;
		color: inherit;
		border-bottom: 1px solid rgb(var(--line));
		text-decoration: none;
	}
	.post-item.is-hidden {
		display: none;
	}
	.post-meta {
		display: grid;
		gap: 0.35rem;
		color: rgb(var(--muted));
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.4;
		text-transform: uppercase;
	}
	.category-badge {
		width: fit-content;
		padding: 0.22rem 0.55rem;
		color: var(--accent);
		background: rgba(23, 74, 124, 0.06);
		border: 1px solid rgba(23, 74, 124, 0.16);
		border-radius: 999px;
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0;
	}
	.post-body h2 {
		display: -webkit-box;
		margin: 0 0 0.45rem;
		font-size: clamp(1.25rem, 2vw, 1.55rem);
		line-height: 1.28;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	.post-body p {
		max-width: 690px;
		margin: 0;
		color: rgb(var(--muted));
		line-height: 1.65;
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.8rem;
	}
	.post-tags span {
		padding: 0.18rem 0.5rem;
		color: rgb(var(--muted));
		background: rgb(var(--surface));
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		font-size: 0.76rem;
		font-weight: 700;
	}
	.post-item:hover h2 {
		color: var(--accent);
	}
	.post-list.compact .post-body p {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	.empty-state {
		margin-top: 2rem;
		padding: 2rem 0;
		border-top: 1px solid rgb(var(--line));
		border-bottom: 1px solid rgb(var(--line));
	}
	.empty-label {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 800;
		text-transform: uppercase;
	}
	.empty-state h2 {
		margin-bottom: 0.45rem;
		font-size: 1.35rem;
	}
	.empty-state p:last-child {
		max-width: 560px;
		margin: 0;
		color: rgb(var(--muted));
	}
	@media (max-width: 760px) {
		.post-item {
			grid-template-columns: 1fr;
			gap: 0.8rem;
			padding: 1.2rem 0;
		}
		.post-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}
	}
</style>
