---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { CORE_TAGS } from '../consts';
import { getPostThumbnail } from '../utils/post-thumbnail';

interface Props {
	posts: CollectionEntry<'blog'>[];
	layout?: 'grid' | 'home';
	maxTags?: number;
	showCategory?: boolean;
}

const { posts, layout = 'grid', maxTags = 3, showCategory = true } = Astro.props;
---

<section class:list={['post-card-list', `post-card-list--${layout}`]} aria-label="글 목록" data-post-list>
	{posts.map((post) => {
		const thumbnail = getPostThumbnail(post);
		const visibleTags = post.data.tags.filter((tag) => CORE_TAGS.includes(tag)).slice(0, maxTags);

		return (
			<a
				class:list={['post-card', { 'has-thumbnail': thumbnail, 'no-thumbnail': !thumbnail }]}
				href={`/blog/${post.id}/`}
				data-post-item
				data-umami-event="post-click"
				data-umami-event-post={post.id}
				data-title={post.data.title}
				data-description={post.data.description}
				data-category={post.data.category}
				data-tags={post.data.tags.join(' ')}
			>
				{thumbnail && (
					<div class="post-thumbnail">
						<img src={thumbnail} alt="" loading="lazy" decoding="async" />
					</div>
				)}
				<div class="post-card-copy">
					<div class="post-card-meta">
						{showCategory && <span>{post.data.category}</span>}
						<FormattedDate date={post.data.pubDate} showTime={post.data.showTime} showSeconds={false} />
					</div>
					<h2>{post.data.title}</h2>
					<p class="post-card-description">{post.data.description}</p>
					{visibleTags.length > 0 && (
						<div class="post-card-tags" aria-label="태그">
							{visibleTags.map((tag) => <span>{tag}</span>)}
						</div>
					)}
				</div>
			</a>
		);
	})}
</section>

<style>
	.post-card-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2.5rem 1.8rem;
		border-top: 1px solid rgb(var(--line));
		padding-top: 1.45rem;
	}
	.post-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}
	.post-card[hidden] {
		display: none !important;
	}
	.post-thumbnail {
		flex: 0 0 auto;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		margin-bottom: 1rem;
		background: rgb(var(--surface));
		border: 1px solid rgb(var(--line));
		border-radius: 4px;
	}
	.post-thumbnail img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 180ms ease;
	}
	.post-card:hover .post-thumbnail img {
		transform: scale(1.025);
	}
	.post-card-copy {
		display: flex;
		flex-direction: column;
	}
	.no-thumbnail .post-card-copy {
		border-top: 2px solid var(--accent);
		padding-top: 1rem;
	}
	.post-card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.42rem;
		align-items: center;
		margin-bottom: 0.65rem;
		color: rgb(var(--muted));
		font-size: 0.76rem;
		font-weight: 700;
		line-height: 1.4;
	}
	.post-card-meta > span:first-child {
		color: var(--accent);
		font-weight: 800;
	}
	.post-card-meta > span:first-child::after {
		content: '·';
		margin-left: 0.42rem;
		color: rgb(var(--line));
	}
	.post-card h2 {
		display: -webkit-box;
		min-height: calc(1.32em * 2);
		margin: 0 0 0.55rem;
		font-size: clamp(1.18rem, 1.75vw, 1.52rem);
		line-height: 1.32;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	.post-card-description {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		margin: 0;
		color: rgb(var(--muted));
		line-height: 1.62;
	}
	.post-card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.85rem;
	}
	.post-card-tags span {
		min-height: 30px;
		padding: 0.35rem 0.7rem;
		color: rgb(var(--muted));
		background: rgba(var(--gray-light), 0.6);
		border: 0;
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 750;
		line-height: 1.25;
	}
	.post-card:hover h2 {
		color: var(--accent);
	}
	.post-card-list--home {
		grid-template-columns: 1fr;
		gap: 0;
		border-top: 0;
		padding-top: 0;
	}
	.post-card-list--home .post-card {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 13.5rem;
		gap: 1.5rem;
		align-items: center;
		margin: 0 -1rem;
		padding: 1.55rem 3.25rem 1.55rem 1rem;
		border-radius: 1.25rem;
		transition: background-color 160ms ease, transform 160ms ease;
	}
	.post-card-list--home .post-card::after {
		position: absolute;
		top: 50%;
		right: 1rem;
		color: rgb(var(--muted));
		content: '→';
		transform: translateY(-50%);
		transition: color 160ms ease, transform 160ms ease;
	}
	.post-card-list--home .post-card:hover {
		background: rgba(var(--gray-light), 0.45);
	}
	.post-card-list--home .post-card:hover h2 {
		color: rgb(var(--black));
	}
	.post-card-list--home .post-card:hover::after {
		color: var(--accent);
		transform: translate(0.25rem, -50%);
	}
	.post-card-list--home .post-thumbnail {
		grid-column: 2;
		grid-row: 1;
		aspect-ratio: 16 / 9;
		margin: 0;
		border-radius: 1.2rem;
	}
	.post-card-list--home .post-card-copy {
		grid-column: 1;
		grid-row: 1;
		min-width: 0;
	}
	.post-card-list--home .no-thumbnail {
		grid-template-columns: 1fr;
	}
	.post-card-list--home .no-thumbnail .post-card-copy {
		border-top: 0;
		padding-top: 0;
	}
	.post-card-list--home h2 {
		order: 1;
		min-height: 0;
		margin-bottom: 0.55rem;
		font-size: clamp(1.18rem, 1.6vw, 1.5rem);
		line-height: 1.28;
	}
	.post-card-list--home .post-card-meta {
		order: 2;
		margin: 0;
		font-size: 0.9rem;
	}
	.post-card-list--home .post-card-description {
		display: none;
	}
	.post-card-list--home .post-card-tags {
		order: 0;
		gap: 0.85rem;
		margin: 0 0 0.75rem;
	}
	.post-card-list--home .post-card-tags span {
		min-height: 0;
		padding: 0;
		color: rgba(var(--gray), 0.72);
		background: transparent;
		border-radius: 0;
		font-size: 0.9rem;
		font-weight: 500;
	}
	@media (max-width: 720px) {
		.post-card-list {
			grid-template-columns: 1fr;
		}
		.post-card-list {
			gap: 1.75rem;
		}
		.post-card-list--home {
			gap: 0;
		}
		.post-card-list--home .post-card {
			grid-template-columns: minmax(0, 1fr) 6.5rem;
			gap: 1rem;
			margin: 0 -0.5rem;
			padding: 1.5rem 2.5rem 1.5rem 0.5rem;
		}
		.post-card-list--home .post-card::after {
			right: 0.5rem;
		}
		.post-card-list--home .no-thumbnail {
			grid-template-columns: 1fr;
		}
		.post-card-list--home h2 {
			font-size: 1.1rem;
		}
		.post-card-list--home .post-card-tags {
			gap: 0.55rem;
			margin-bottom: 0.55rem;
		}
		.post-card-list--home .post-card-tags span,
		.post-card-list--home .post-card-meta {
			font-size: 0.78rem;
		}
	}
</style>
