---
import { PROFILE_LINKS, SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p>&copy; {today.getFullYear()} Gunwoo Kim. {SITE_TITLE}.</p>
		<div class="social-links">
			<a href={PROFILE_LINKS.github} target="_blank">GitHub</a>
			<a href={PROFILE_LINKS.velog} target="_blank">Velog</a>
			<a href={PROFILE_LINKS.email}>Email</a>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 2rem 1.25rem 4rem;
		border-top: 1px solid rgb(var(--line));
		color: rgb(var(--muted));
	}
	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1160px;
		margin: 0 auto;
	}
	p {
		margin: 0;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--muted));
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.footer-inner {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
