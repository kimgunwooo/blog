---
import { PROFILE_LINKS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">홈</HeaderLink>
			<HeaderLink href="/blog/">전체 글</HeaderLink>
			<HeaderLink href="/ops-log/">운영 기록</HeaderLink>
			<HeaderLink href="/about/">소개</HeaderLink>
		</div>
		<div class="social-links">
			<button
				class="theme-toggle"
				type="button"
				data-theme-toggle
				aria-label="다크 모드로 전환"
				title="다크 모드로 전환"
				aria-pressed="false"
			>
				<span class="theme-toggle__label theme-toggle__label--light">Light</span>
				<span class="theme-toggle__label theme-toggle__label--dark">Dark</span>
				<span class="theme-toggle__switch" aria-hidden="true">
					<span class="theme-toggle__thumb">
						<svg class="theme-icon theme-icon--sun" viewBox="0 0 24 24">
							<circle cx="12" cy="12" r="3.5"></circle>
							<path d="M12 2v2.2M12 19.8V22M4.93 4.93l1.55 1.55M17.52 17.52l1.55 1.55M2 12h2.2M19.8 12H22M4.93 19.07l1.55-1.55M17.52 6.48l1.55-1.55"></path>
						</svg>
						<svg class="theme-icon theme-icon--moon" viewBox="0 0 24 24">
							<path d="M20 15.2A8.5 8.5 0 1 1 8.8 4 6.8 6.8 0 0 0 20 15.2Z"></path>
						</svg>
					</span>
				</span>
			</button>
			<a class="social-link" href={PROFILE_LINKS.github} target="_blank" aria-label="GitHub">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49v-1.9c-2.78.62-3.37-1.2-3.37-1.2-.45-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.58 2.36 1.12 2.93.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.96c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.78-4.57 5.04.36.32.68.95.68 1.92v2.84c0 .27.18.6.69.49A10.2 10.2 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"></path>
				</svg>
			</a>
			<a class="social-link" href={PROFILE_LINKS.velog} target="_blank" aria-label="Velog">
				<span aria-hidden="true">v</span>
			</a>
			<a class="social-link" href={PROFILE_LINKS.email} aria-label="Email">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M4.75 5.5h14.5c.97 0 1.75.78 1.75 1.75v9.5c0 .97-.78 1.75-1.75 1.75H4.75A1.75 1.75 0 0 1 3 16.75v-9.5c0-.97.78-1.75 1.75-1.75Zm0 1.5a.25.25 0 0 0-.25.25v.54l7.5 4.54 7.5-4.54v-.54a.25.25 0 0 0-.25-.25H4.75Zm14.75 2.54-7.11 4.31a.75.75 0 0 1-.78 0L4.5 9.54v7.21c0 .14.11.25.25.25h14.5c.14 0 .25-.11.25-.25V9.54Z"></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1.25rem;
		background: var(--page-bg);
		border-bottom: 1px solid rgb(var(--line));
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		letter-spacing: 0;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1160px;
		margin: 0 auto;
		min-height: 64px;
		gap: 1rem;
	}
	nav a {
		padding: 0.75rem 0.5rem;
		color: rgb(var(--black));
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.9rem;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	header nav .social-links,
	header nav .social-links a {
		display: flex;
		align-items: center;
		color: rgb(var(--gray-dark));
	}
	header nav .social-links {
		gap: 0.4rem;
	}
	header nav .social-links a {
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1px solid rgb(var(--line));
		border-radius: 999px;
		background: rgb(var(--surface-strong));
	}
	header nav .social-links .social-link svg {
		width: 17px;
		height: 17px;
		fill: currentColor;
	}
	header nav .social-links .social-link span {
		font-size: 1.05rem;
		font-weight: 800;
		line-height: 1;
		transform: translateY(-1px);
	}
	header nav .social-links a:hover {
		color: var(--accent);
		border-color: rgba(23, 74, 124, 0.35);
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		position: relative;
		width: 104px;
		height: 34px;
		padding: 0;
		color: rgb(var(--gray-dark));
		background: transparent;
		border: 0;
		border-radius: 999px;
		cursor: pointer;
	}
	.theme-toggle:hover {
		color: rgb(var(--gray-dark));
	}
	.theme-toggle__label {
		position: absolute;
		top: 50%;
		z-index: 1;
		font-size: 0.65rem;
		font-weight: 800;
		line-height: 1;
		letter-spacing: 0;
		transform: translateY(-50%);
		transition: opacity 160ms ease;
	}
	.theme-toggle__label--light {
		left: 0;
		opacity: 1;
	}
	.theme-toggle__label--dark {
		right: 0;
		opacity: 0;
	}
	.theme-toggle__switch {
		position: absolute;
		top: 5px;
		right: 0;
		width: 44px;
		height: 24px;
		border-radius: 999px;
		background: #f8e7a9;
		transition: background 180ms ease, left 180ms ease, right 180ms ease;
	}
	.theme-toggle__thumb {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		color: #fff;
		background: #f3bf27;
		box-shadow: 0 1px 3px rgba(15, 23, 42, 0.18);
		transition: transform 180ms ease, background 180ms ease;
	}
	.theme-icon {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
	}
	.theme-icon--moon {
		display: none;
	}
	:global(html[data-theme='dark']) .theme-icon--sun {
		display: none;
	}
	:global(html[data-theme='dark']) .theme-icon--moon {
		display: block;
	}
	:global(html[data-theme='dark']) .theme-toggle__label--light {
		opacity: 0;
	}
	:global(html[data-theme='dark']) .theme-toggle__label--dark {
		opacity: 1;
	}
	:global(html[data-theme='dark']) .theme-toggle__switch {
		left: 0;
		right: auto;
		background: #0d3c52;
	}
	:global(html[data-theme='dark']) .theme-toggle__thumb {
		transform: translateX(20px);
		background: #2ea9e8;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 0.75rem;
		}
		nav {
			min-height: auto;
			padding: 0.75rem 0;
			align-items: center;
			flex-direction: row;
			gap: 0.5rem;
		}
		.internal-links {
			min-width: 0;
			flex: 1 1 auto;
			overflow-x: auto;
			white-space: nowrap;
		}
		header nav .social-links {
			display: flex;
			align-self: center;
			flex: 0 0 auto;
		}
		header nav .social-links .social-link {
			display: none;
		}
	}
</style>

<script is:inline>
	const themeToggle = document.querySelector('[data-theme-toggle]');
	const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');
	const getStoredTheme = () => {
		try {
			return localStorage.getItem('theme');
		} catch {
			return null;
		}
	};
	const setStoredTheme = (theme) => {
		try {
			localStorage.setItem('theme', theme);
		} catch {
			// Private browsing can disable localStorage.
		}
	};
	const applyTheme = (theme) => {
		const isDark = theme === 'dark';
		document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
		themeToggle?.setAttribute('aria-label', isDark ? '라이트 모드로 전환' : '다크 모드로 전환');
		themeToggle?.setAttribute('title', isDark ? '라이트 모드로 전환' : '다크 모드로 전환');
		themeToggle?.setAttribute('aria-pressed', String(isDark));
	};

	themeToggle?.addEventListener('click', () => {
		const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		setStoredTheme(nextTheme);
		applyTheme(nextTheme);
	});
	themeMedia.addEventListener?.('change', (event) => {
		if (!getStoredTheme()) applyTheme(event.matches ? 'dark' : 'light');
	});
	applyTheme(document.documentElement.dataset.theme || (themeMedia.matches ? 'dark' : 'light'));
</script>
