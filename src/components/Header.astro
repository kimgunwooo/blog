---
import { PROFILE_LINKS, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Notes</HeaderLink>
			<HeaderLink href="/categories">Categories</HeaderLink>
			<HeaderLink href="/ops-log">Ops Log</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href={PROFILE_LINKS.github} target="_blank">
				<span>GitHub</span>
			</a>
			<a href={PROFILE_LINKS.velog} target="_blank">
				<span>Velog</span>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1.25rem;
		background: white;
		border-bottom: 1px solid rgb(var(--line));
	}
	h2 {
		margin: 0;
		font-size: 1rem;
		letter-spacing: 0;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1120px;
		margin: 0 auto;
		min-height: 64px;
		gap: 1rem;
	}
	nav a {
		padding: 0.75rem 0.5rem;
		color: var(--black);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.9rem;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: rgb(var(--muted));
	}
	@media (max-width: 720px) {
		header {
			padding: 0 0.75rem;
		}
		nav {
			min-height: auto;
			padding: 0.75rem 0;
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}
		.internal-links {
			width: 100%;
			overflow-x: auto;
			white-space: nowrap;
		}
		.social-links {
			display: none;
		}
	}
</style>
